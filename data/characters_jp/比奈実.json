{
 "character": "比奈実",
 "count": 58,
 "lines": [
  {
   "file": "004・学院初日ver1.04",
   "text": "「初めまして！　あなたの担任になる[ちゅう　]中[　じょう]条[ひ]比[な]奈[み]実です」",
   "voice": "hin004_003"
  },
  {
   "file": "004・学院初日ver1.04",
   "text": "「はい、よろしくお願いします」",
   "voice": "hin004_004"
  },
  {
   "file": "004・学院初日ver1.04",
   "text": "「大丈夫ですよ。むしろ、迷ったり事故に遭ったわけじゃなくて安心しました」",
   "voice": "hin004_005"
  },
  {
   "file": "004・学院初日ver1.04",
   "text": "「簡単な手続きと確認もありますから、今から職員室に一緒に来て下さい」",
   "voice": "hin004_006"
  },
  {
   "file": "004・学院初日ver1.04",
   "text": "「ありがとう。それじゃあ、席はあの一番後ろに。鞍馬君の後ろですね」",
   "voice": "hin004_007"
  },
  {
   "file": "004・学院初日ver1.04",
   "text": "「何か困ったことなどあれば、ちゃんと面倒を見てあげて下さい、鞍馬君」",
   "voice": "hin004_008"
  },
  {
   "file": "004・学院初日ver1.04",
   "text": "「さて。それじゃあ始業式です。みなさん移動しましょうか」",
   "voice": "hin004_009"
  },
  {
   "file": "004・学院初日ver1.04",
   "text": "「あ、そうだ有地君」",
   "voice": "hin004_010"
  },
  {
   "file": "004・学院初日ver1.04",
   "text": "「帰る前に、ちょっと用事がありますから少し残ってくれますか？　時間はそんなにかからないはずですので」",
   "voice": "hin004_011"
  },
  {
   "file": "004・学院初日ver1.04",
   "text": "「すみません、遅くなりました」",
   "voice": "hin004_012"
  },
  {
   "file": "004・学院初日ver1.04",
   "text": "「駒川先生はこの学院の嘱託医でもあるんです」",
   "voice": "hin004_013"
  },
  {
   "file": "004・学院初日ver1.04",
   "text": "「有地君は、何かお医者さんにお世話になるようなことが？」",
   "voice": "hin004_014"
  },
  {
   "file": "004・学院初日ver1.04",
   "text": "「そうですか。それならいいんですが」",
   "voice": "hin004_015"
  },
  {
   "file": "004・学院初日ver1.04",
   "text": "「いえ。それでは、わたしはこれで」",
   "voice": "hin004_016"
  },
  {
   "file": "005・鍛錬ver1.04",
   "text": "「あ、もうチャイムの時間ですね」",
   "voice": "hin005_001"
  },
  {
   "file": "005・鍛錬ver1.04",
   "text": "「それでは今日はここまでです」",
   "voice": "hin005_002"
  },
  {
   "file": "005・鍛錬ver1.04",
   "text": "「それでは、みなさんまた明日。くれぐれも事故に遭わないように気を付けて下さい」",
   "voice": "hin005_003"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「リヒテナウアーさんは、旅館で働きながら留学をしているそうです」",
   "voice": "hin007_001"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「困っていることがあれば、ちゃんと力を貸してあげてくださいね」",
   "voice": "hin007_002"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「はい。質問はそこまで」",
   "voice": "hin007_003"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「何か気になることがある場合は、休憩時間にして下さい」",
   "voice": "hin007_004"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「はいはーい。席について下さい、授業を始めますよー」",
   "voice": "hin007_005"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「そして平安時代の末期から鎌倉時代にかけて、仏教の変革がもたらされるわけです」",
   "voice": "hin007_006"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「[　じょう　]浄[　どし]土[　ゅう]宗、[　じょう　]浄[　どし]土[　んし]真[　ゅう]宗、[じし]時[ゅう]宗、[ほっ]法[けし]華[ゅう]宗、[　りんざ　]臨[　いし]済[　ゅう]宗、[　そうと　]曹[　うし]洞[　ゅう]宗」",
   "voice": "hin007_007"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「この六つの宗派が、鎌倉新仏教と言われていますが……」",
   "voice": "hin007_008"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「これらはもう少し後の時代の事ですので、後日改めて説明しましょう」",
   "voice": "hin007_009"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「有地君」",
   "voice": "hin007_010"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「有地将臣君？」",
   "voice": "hin007_011"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「調子が悪いんですか？」",
   "voice": "hin007_012"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「でしたら授業には集中するように」",
   "voice": "hin007_013"
  },
  {
   "file": "009・謎の欠片ver1.03",
   "text": "「今日はここまで。それでは皆さん、気をつけて帰ってくださいね」",
   "voice": "hin009_001"
  },
  {
   "file": "101・芳乃－弁当ver1.02",
   "text": "「そうして、院を警固する[さい]西[めん]面[のぶ]武[し]士が新たに創設されたわけですね」",
   "voice": "hin101_001"
  },
  {
   "file": "101・芳乃－弁当ver1.02",
   "text": "「[ほく]北[めん]面[のぶ]武[し]士は白河上皇の時、寺社に対抗して創設されたもの」",
   "voice": "hin101_002"
  },
  {
   "file": "101・芳乃－弁当ver1.02",
   "text": "「西面武士は後鳥羽上皇の時、倒幕するために創設されたもの、ということです」",
   "voice": "hin101_003"
  },
  {
   "file": "101・芳乃－弁当ver1.02",
   "text": "「この２つは両方とも朝廷の警備ではありますが、目的が違うことを覚えておいて下さいね」",
   "voice": "hin101_004"
  },
  {
   "file": "101・芳乃－弁当ver1.02",
   "text": "「はい。今日の授業もおしまいですね、お疲れ様でしたー」",
   "voice": "hin101_005"
  },
  {
   "file": "102・芳乃－告白ver1.03",
   "text": "「それでは、みなさん気を付けて帰って下さいね」",
   "voice": "hin102_001"
  },
  {
   "file": "104・芳乃－記者会見ver1.05",
   "text": "「皆さん何してるんですか？　もう始業の時間ですよ」",
   "voice": "hin104_001"
  },
  {
   "file": "104・芳乃－記者会見ver1.05",
   "text": "「話がすんだのなら解散。みんな席について下さい」",
   "voice": "hin104_002"
  },
  {
   "file": "104・芳乃－記者会見ver1.05",
   "text": "「鞍馬さんは別の学年でしょう。早く自分の教室に戻らないとダメですよ」",
   "voice": "hin104_003"
  },
  {
   "file": "104・芳乃－記者会見ver1.05",
   "text": "「それからそっちの――って、先生方まで何を黙ってみているんですか！」",
   "voice": "hin104_004"
  },
  {
   "file": "104・芳乃－記者会見ver1.05",
   "text": "「授業をするので出て行って下さいっ」",
   "voice": "hin104_005"
  },
  {
   "file": "107・芳乃－獣耳ver1.02",
   "text": "「そうして、鎌倉幕府による統治が行われていくわけですね」",
   "voice": "hin107_001"
  },
  {
   "file": "107・芳乃－獣耳ver1.02",
   "text": "「どうしました、有地君。何かわからないことがありますか？」",
   "voice": "hin107_002"
  },
  {
   "file": "107・芳乃－獣耳ver1.02",
   "text": "「……わかりました。でも、授業はちゃんと聞いておいて下さいね」",
   "voice": "hin107_003"
  },
  {
   "file": "107・芳乃－獣耳ver1.02",
   "text": "「では、続けますね」",
   "voice": "hin107_004"
  },
  {
   "file": "201・茉子－婚約解消ver1.01",
   "text": "「こうして朝廷の[　りょう　]両[　とう]統[　てつ]迭[　りつ]立は[ぶん]文[ぽう]保の和談で収拾をつけようとしたのですが協議は難航」",
   "voice": "hin201_001"
  },
  {
   "file": "201・茉子－婚約解消ver1.01",
   "text": "「結局皇位継承の明確なルールは画定することはできず、対立は続いてしまいます」",
   "voice": "hin201_002"
  },
  {
   "file": "201・茉子－婚約解消ver1.01",
   "text": "「その翌年、花園天皇の譲位を受けて即位するのが[だい]大[かく]覚[じ]寺[とう]統の後醍醐天皇なわけですが――」",
   "voice": "hin201_003"
  },
  {
   "file": "201・茉子－婚約解消ver1.01",
   "text": "「それはまた次回のお話ということで、今日はここまでにしておきましょうか」",
   "voice": "hin201_004"
  },
  {
   "file": "208・茉子－いちゃラヴver1.00",
   "text": "「ちょっと２人とも、何を笑っているんですかっ」",
   "voice": "hin208_001"
  },
  {
   "file": "208・茉子－いちゃラヴver1.00",
   "text": "「先生は怒っているんですよ！　話を聞いていますか！？」",
   "voice": "hin208_002"
  },
  {
   "file": "208・茉子－いちゃラヴver1.00",
   "text": "「だから２人とも笑っていないで、ちゃんと反省を\\nしなさいっ！」",
   "voice": "hin208_003"
  },
  {
   "file": "305・ムラサメちゃんルート０５ver1.2",
   "text": "「はい、今日はここまで」",
   "voice": "hin305_001"
  },
  {
   "file": "305・ムラサメちゃんルート０５ver1.2",
   "text": "「掃除当番の子以外は、気をつけて帰ってください」",
   "voice": "hin305_002"
  },
  {
   "file": "308・ムラサメちゃんルート０８ver1.2",
   "text": "「では、今日はここまで」",
   "voice": "hin308_001"
  },
  {
   "file": "308・ムラサメちゃんルート０８ver1.2",
   "text": "「掃除当番の人は、よろしくお願いしますね」",
   "voice": "hin308_002"
  },
  {
   "file": "505・サブ－ピンとくる２人ver1.00",
   "text": "「今日はお疲れ様でした」",
   "voice": "hin505_001"
  }
 ]
}