{
 "character": "おじいさん",
 "count": 7,
 "lines": [
  {
   "file": "104・芳乃－記者会見ver1.05",
   "text": "「もうワシの生きているうちには、巫女姫様は結婚せぬのかと悲しい思いだったが……」",
   "voice": "oji104_001"
  },
  {
   "file": "104・芳乃－記者会見ver1.05",
   "text": "「まさか突然恋人をおつくりになさるとは……めでたい！」",
   "voice": "oji104_002"
  },
  {
   "file": "104・芳乃－記者会見ver1.05",
   "text": "「これはもう巫女姫様の花嫁姿を見るまで、死ぬわけにはいかんな」",
   "voice": "oji104_003"
  },
  {
   "file": "104・芳乃－記者会見ver1.05",
   "text": "「なんと彼が婿殿ですか！」",
   "voice": "oji104_004"
  },
  {
   "file": "104・芳乃－記者会見ver1.05",
   "text": "「おーい、２人とも何しとる。そんなところに立ってないで、こっちに座って話を聞かせてくれ」",
   "voice": "oji104_005"
  },
  {
   "file": "104・芳乃－記者会見ver1.05",
   "text": "「そこら辺、婿殿の方はどう考えているのですかな？」",
   "voice": "oji104_006"
  },
  {
   "file": "106・芳乃－キスver1.01",
   "text": "「………」",
   "voice": "oji106_001"
  }
 ]
}