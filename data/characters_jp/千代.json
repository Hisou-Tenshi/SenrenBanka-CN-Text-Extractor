{
 "character": "千代",
 "count": 20,
 "lines": [
  {
   "file": "502・サブ－アルバイトver1.00",
   "text": "「なに？　小春ちゃんと有地君は知り合いなの？」",
   "voice": "chi502_004"
  },
  {
   "file": "502・サブ－アルバイトver1.00",
   "text": "「へー……」",
   "voice": "chi502_005"
  },
  {
   "file": "502・サブ－アルバイトver1.00",
   "text": "「こっちもプリン、お願いします」",
   "voice": "chi502_006"
  },
  {
   "file": "502・サブ－アルバイトver1.00",
   "text": "「社長もお疲れ様です」",
   "voice": "chi502_007"
  },
  {
   "file": "502・サブ－アルバイトver1.00",
   "text": "「それじゃあ、休憩入ります」",
   "voice": "chi502_008"
  },
  {
   "file": "502・サブ－アルバイトver1.00",
   "text": "「小春ちゃーん、ちょっといい？」",
   "voice": "chi502_009"
  },
  {
   "file": "502・サブ－アルバイトver1.00",
   "text": "「それじゃあ、私はお先に失礼します」",
   "voice": "chi502_010"
  },
  {
   "file": "502・サブ－アルバイトver1.00",
   "text": "「え？　あー、別に迷惑だなんて思ってないってば」",
   "voice": "chi502_011"
  },
  {
   "file": "502・サブ－アルバイトver1.00",
   "text": "「でも、覚えることはちゃんと覚えようね」",
   "voice": "chi502_012"
  },
  {
   "file": "502・サブ－アルバイトver1.00",
   "text": "「それじゃあ、お疲れ様」",
   "voice": "chi502_013"
  },
  {
   "file": "504・サブ－芦花の目覚めver1.00",
   "text": "「おはようございます」",
   "voice": "chi504_001"
  },
  {
   "file": "504・サブ－芦花の目覚めver1.00",
   "text": "「は、はい……頑張ります」",
   "voice": "chi504_002"
  },
  {
   "file": "504・サブ－芦花の目覚めver1.00",
   "text": "「おはよう、有地君」",
   "voice": "chi504_003"
  },
  {
   "file": "504・サブ－芦花の目覚めver1.00",
   "text": "「小春ちゃーん、ちょっと待ってー」",
   "voice": "chi504_004"
  },
  {
   "file": "504・サブ－芦花の目覚めver1.00",
   "text": "「あっ、有地君。表の掃除、頼んでもいい？」",
   "voice": "chi504_005"
  },
  {
   "file": "504・サブ－芦花の目覚めver1.00",
   "text": "「お疲れ様、有地君」",
   "voice": "chi504_006"
  },
  {
   "file": "504・サブ－芦花の目覚めver1.00",
   "text": "「ありがとう。じゃあ、今のうちに休憩取っちゃって」",
   "voice": "chi504_007"
  },
  {
   "file": "504・サブ－芦花の目覚めver1.00",
   "text": "「時間内に戻ってくれれば、何の問題もないよ」",
   "voice": "chi504_008"
  },
  {
   "file": "504・サブ－芦花の目覚めver1.00",
   "text": "「お疲れ様です。お先に失礼しますね」",
   "voice": "chi504_009"
  },
  {
   "file": "522・サブ－芦花（その後）ver1.00",
   "text": "「ちょっと２人とも。ちゃんと仕事をして頂戴」",
   "voice": "chi522_001"
  }
 ]
}