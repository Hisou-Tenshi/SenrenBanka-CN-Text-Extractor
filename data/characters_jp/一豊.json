{
 "character": "一豊",
 "count": 48,
 "lines": [
  {
   "file": "007・レナ転入ver1.03",
   "text": "「[おお]大[ひら]平[かず]一[とよ]豊。今度は忘れるなよ」",
   "voice": "kzt007_005"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「で、鞍馬がなんで女子に毛嫌いされているのかと言えばだ」",
   "voice": "kzt007_006"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「問題はその後だ。こいつ、まーたクラスの女子と付き合いやがった」",
   "voice": "kzt007_007"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「おかげで元カノと今カノが教室の中で対立。ギスギスして雰囲気最悪」",
   "voice": "kzt007_008"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「そしたらコロッと手の平を返して、女子たちが結託しちゃってさ」",
   "voice": "kzt007_009"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「誰彼かまわず声をかけまくるから、余計に悪評が立つんだよ」",
   "voice": "kzt007_010"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「お前絶対反省してないだろ？　教室の空気を悪くするのはやめろよ。こっちまで迷惑なんだから」",
   "voice": "kzt007_011"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「お前は放っておいたら、巫女姫様にも粉をかけそうだからなー」",
   "voice": "kzt007_012"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「おう、それは思ってた」",
   "voice": "kzt007_013"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「前からちょっと気にはなってたんだよ。わりと巫女姫様と気軽に話してるからさ」",
   "voice": "kzt007_014"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「それはそうだけど……」",
   "voice": "kzt007_015"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「俺んとこの母ちゃんも言ってたぞ。学院卒業する頃には結婚して子供産む人もいるんだとさ」",
   "voice": "kzt007_016"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「当たり前だろ、何言ってんだよ。巫女姫様の婚約者が有地なんてありえないって」",
   "voice": "kzt007_018"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「違うんだ、有地。決してバカにしてるつもりはないんだ。悪い悪い」",
   "voice": "kzt007_020"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「俺らの中で、巫女姫様の婚約者になれるのは完璧な人間っていう理想像があってさ」",
   "voice": "kzt007_021"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「エロくて薄い本がそこら辺で売られてるとか！」",
   "voice": "kzt007_022"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「なんだ、そうなのか……」",
   "voice": "kzt007_023"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「いや、でも、そういう店にすぐに行けるのはいいよなぁ」",
   "voice": "kzt007_024"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「じゃ、また後でな」",
   "voice": "kzt007_025"
  },
  {
   "file": "104・芳乃－記者会見ver1.05",
   "text": "「どうなんですか！？　どっ、どどどどどこまでいってるんですか！？」",
   "voice": "kzt104_001"
  },
  {
   "file": "104・芳乃－記者会見ver1.05",
   "text": "「男としてどうなんだー？」",
   "voice": "kzt104_002"
  },
  {
   "file": "104・芳乃－記者会見ver1.05",
   "text": "「もう終わり？」",
   "voice": "kzt104_003"
  },
  {
   "file": "202・茉子－実家ver1.01",
   "text": "「なになに？　もしかして、下着が見えたりする？」",
   "voice": "kzt202_001"
  },
  {
   "file": "202・茉子－実家ver1.01",
   "text": "「あっ、ホントに見えてる」",
   "voice": "kzt202_002"
  },
  {
   "file": "202・茉子－実家ver1.01",
   "text": "「お前、人のこと言えないだろ！」",
   "voice": "kzt202_003"
  },
  {
   "file": "202・茉子－実家ver1.01",
   "text": "「くっ……これだから鞍馬は」",
   "voice": "kzt202_004"
  },
  {
   "file": "202・茉子－実家ver1.01",
   "text": "「お、おう？　……なんだ？」",
   "voice": "kzt202_005"
  },
  {
   "file": "202・茉子－実家ver1.01",
   "text": "「有地がそんなことを話題にするなんて珍しい」",
   "voice": "kzt202_006"
  },
  {
   "file": "202・茉子－実家ver1.01",
   "text": "「巫女姫様に、常陸さん。レナさんもそうだし……考えてみると随分レベル高いな、この空間」",
   "voice": "kzt202_007"
  },
  {
   "file": "202・茉子－実家ver1.01",
   "text": "「もうちょっと吸っておこう。すーーーー……」",
   "voice": "kzt202_008"
  },
  {
   "file": "202・茉子－実家ver1.01",
   "text": "「そりゃ可愛いとは思うし、性格も悪いと思ったことはないけど――」",
   "voice": "kzt202_009"
  },
  {
   "file": "202・茉子－実家ver1.01",
   "text": "「昔は何度か遊びに誘ったこともあったんだけどな。一度も乗ってきたことがない」",
   "voice": "kzt202_010"
  },
  {
   "file": "202・茉子－実家ver1.01",
   "text": "「まあ、それは巫女姫様も同じなんだけど」",
   "voice": "kzt202_011"
  },
  {
   "file": "202・茉子－実家ver1.01",
   "text": "「大変だよな、常陸家も。代々、巫女姫様のところにお務めしてるんだろ？」",
   "voice": "kzt202_012"
  },
  {
   "file": "202・茉子－実家ver1.01",
   "text": "「それは違うと思うぞ？　俺、小学校の頃に調べたから」",
   "voice": "kzt202_013"
  },
  {
   "file": "202・茉子－実家ver1.01",
   "text": "「ほら“自分たちの町の歴史を知ろう”って、班に分かれて調べるやつ、昔やっただろ？」",
   "voice": "kzt202_014"
  },
  {
   "file": "202・茉子－実家ver1.01",
   "text": "「俺の班は自分たちの先祖、家系について調べたんだよ」",
   "voice": "kzt202_015"
  },
  {
   "file": "202・茉子－実家ver1.01",
   "text": "「重臣は鞍馬家とか田宮家で、調べる限り常陸家のことは載ってなかった」",
   "voice": "kzt202_016"
  },
  {
   "file": "202・茉子－実家ver1.01",
   "text": "「そういう可能性も、確かにあるな」",
   "voice": "kzt202_017"
  },
  {
   "file": "206・茉子－オナニーver1.00",
   "text": "「おいおい……なんか手まで握ってたぞ？」",
   "voice": "kzt206_001"
  },
  {
   "file": "208・茉子－いちゃラヴver1.00",
   "text": "「おはよう、有地」",
   "voice": "kzt208_001"
  },
  {
   "file": "208・茉子－いちゃラヴver1.00",
   "text": "「なんだよ？　その微笑みは」",
   "voice": "kzt208_002"
  },
  {
   "file": "208・茉子－いちゃラヴver1.00",
   "text": "「謝られると余計にムカつくんだが」",
   "voice": "kzt208_003"
  },
  {
   "file": "208・茉子－いちゃラヴver1.00",
   "text": "「……まあ、それだけ幸せな付き合いが続いてるってことなのか」",
   "voice": "kzt208_004"
  },
  {
   "file": "208・茉子－いちゃラヴver1.00",
   "text": "「ちなみにさー、彼女ってどうやったら作れるんだ？」",
   "voice": "kzt208_005"
  },
  {
   "file": "208・茉子－いちゃラヴver1.00",
   "text": "「つまり……有地も自分から動いたのか？」",
   "voice": "kzt208_006"
  },
  {
   "file": "208・茉子－いちゃラヴver1.00",
   "text": "「しかし……まさか本当に付き合ってるとは。最初はかつがれてると思ってたからなぁ」",
   "voice": "kzt208_007"
  },
  {
   "file": "208・茉子－いちゃラヴver1.00",
   "text": "「嫌がらせみたいに見せつけてきたら、男子全員でボコるからな？」",
   "voice": "kzt208_008"
  }
 ]
}