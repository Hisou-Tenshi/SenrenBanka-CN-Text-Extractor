{
 "character": "怨念",
 "count": 13,
 "lines": [
  {
   "file": "108・芳乃－解呪ver1.01",
   "text": "『憎い……憎い……憎い、憎い、憎い、憎い、憎い……』",
   "voice": "onn108_001"
  },
  {
   "file": "108・芳乃－解呪ver1.01",
   "text": "『許さない……許さない……許さない……』",
   "voice": "onn108_002"
  },
  {
   "file": "108・芳乃－解呪ver1.01",
   "text": "『俺は決して許さない。あいつも、あいつの家族も……その子孫もっ！』",
   "voice": "onn108_003"
  },
  {
   "file": "108・芳乃－解呪ver1.01",
   "text": "『……許さない……末代まで呪ってやる』",
   "voice": "onn108_004"
  },
  {
   "file": "108・芳乃－解呪ver1.01",
   "text": "『憎い、あいつが憎い……あいつの繁栄が憎い……』",
   "voice": "onn108_005"
  },
  {
   "file": "108・芳乃－解呪ver1.01",
   "text": "『憎い……憎い……憎い……』",
   "voice": "onn108_006"
  },
  {
   "file": "108・芳乃－解呪ver1.01",
   "text": "「ただで消えたりはしない。ここで全てを終わらせてやる。あいつの残した全てを奪ってやる」",
   "voice": "onn108_007"
  },
  {
   "file": "108・芳乃－解呪ver1.01",
   "text": "「お前を殺せば、終わる。あいつの全てを終わらせられる」",
   "voice": "onn108_008"
  },
  {
   "file": "108・芳乃－解呪ver1.01",
   "text": "「俺が消える前に……お前を」",
   "voice": "onn108_009"
  },
  {
   "file": "108・芳乃－解呪ver1.01",
   "text": "「道連れにして、全てを終わらせてやる」",
   "voice": "onn108_010"
  },
  {
   "file": "108・芳乃－解呪ver1.01",
   "text": "「せめてお前だけは、俺と共に死ね」",
   "voice": "onn108_011"
  },
  {
   "file": "108・芳乃－解呪ver1.01",
   "text": "「終わらせてやる。許さない、俺は許さない――」",
   "voice": "onn108_012"
  },
  {
   "file": "108・芳乃－解呪ver1.01",
   "text": "「―――………」",
   "voice": "onn108_013"
  }
 ]
}