{
 "character": "典子",
 "count": 59,
 "lines": [
  {
   "file": "007・レナ転入ver1.03",
   "text": "「あ、私は[お]小[の]野[のり]典[こ]子だよー」",
   "voice": "nrk007_005"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「でも、やっぱり外国の人は違うよね……特に凸凹とか」",
   "voice": "nrk007_006"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「まあ、こうして机を並べて一緒に勉強してるぐらいだから」",
   "voice": "nrk007_007"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「なんか変な部分だけおかしいね。そりゃ厳しくもされるかー」",
   "voice": "nrk007_008"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「すでに涙目になってるよ……」",
   "voice": "nrk007_009"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「あっ、わたしはさび抜きの方が好きー」",
   "voice": "nrk007_010"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「やだー、鞍馬君が見てる」",
   "voice": "nrk007_011"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「とっかえひっかえ恋人を変えたり、２人と同時に付き合うような人のことだよ」",
   "voice": "nrk007_012"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「鞍馬君。転入したばっかりの留学生だよ？　そういうの、よくないんじゃないかな？」",
   "voice": "nrk007_013"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「レナちゃん、レナちゃん、一緒に遊びに行かない？」",
   "voice": "nrk007_014"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「そっかー。お仕事じゃ仕方ないね」",
   "voice": "nrk007_015"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「バイバーイ」",
   "voice": "nrk007_016"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「また明日」",
   "voice": "nrk007_017"
  },
  {
   "file": "009・謎の欠片ver1.03",
   "text": "「それじゃあ私は、このレンコンの挟み焼きを生け贄に、胡麻和えを召喚したいでーす」",
   "voice": "nrk009_001"
  },
  {
   "file": "009・謎の欠片ver1.03",
   "text": "「えっへっへ～」",
   "voice": "nrk009_002"
  },
  {
   "file": "009・謎の欠片ver1.03",
   "text": "「本当に！？　ありがとうございます、巫女姫様」",
   "voice": "nrk009_003"
  },
  {
   "file": "101・芳乃－弁当ver1.02",
   "text": "「巫女姫様、急にどうかしたんですか？」",
   "voice": "nrk101_001"
  },
  {
   "file": "104・芳乃－記者会見ver1.05",
   "text": "「つまり巫女姫様は、有地将臣さんのことが好きということで間違いないんですよね」",
   "voice": "nrk104_001"
  },
  {
   "file": "104・芳乃－記者会見ver1.05",
   "text": "「はい！　２年の小野典子です！」",
   "voice": "nrk104_002"
  },
  {
   "file": "104・芳乃－記者会見ver1.05",
   "text": "「いつからお付き合いされているんですか？」",
   "voice": "nrk104_003"
  },
  {
   "file": "104・芳乃－記者会見ver1.05",
   "text": "「おお！　新婚ホヤホヤだぁ～！」",
   "voice": "nrk104_004"
  },
  {
   "file": "104・芳乃－記者会見ver1.05",
   "text": "「付き合ってるんですから、やっぱりキスぐらいはもうしちゃってるんですよね、きゃーー♪」",
   "voice": "nrk104_005"
  },
  {
   "file": "104・芳乃－記者会見ver1.05",
   "text": "「いがーい。有地君って都会から来たから、もっと手が速いんだと思ってた」",
   "voice": "nrk104_007"
  },
  {
   "file": "107・芳乃－獣耳ver1.02",
   "text": "「んー？　なになにどうしたの？」",
   "voice": "nrk107_001"
  },
  {
   "file": "107・芳乃－獣耳ver1.02",
   "text": "「え？　ちょ、ちょっと２人とも？」",
   "voice": "nrk107_002"
  },
  {
   "file": "107・芳乃－獣耳ver1.02",
   "text": "「何があったんだろうね？」",
   "voice": "nrk107_003"
  },
  {
   "file": "107・芳乃－獣耳ver1.02",
   "text": "「あ、帰ってきた」",
   "voice": "nrk107_004"
  },
  {
   "file": "107・芳乃－獣耳ver1.02",
   "text": "「有地君、巫女姫様をイジメるようなことしたら許さないからね」",
   "voice": "nrk107_005"
  },
  {
   "file": "107・芳乃－獣耳ver1.02",
   "text": "「有地君に一緒に追い込みをかけますからね」",
   "voice": "nrk107_006"
  },
  {
   "file": "107・芳乃－獣耳ver1.02",
   "text": "「他にも何か困りごとがあったら、いつでも話して下さい！」",
   "voice": "nrk107_007"
  },
  {
   "file": "107・芳乃－獣耳ver1.02",
   "text": "「私たちじゃ力になれることは少ないかもしれませんけど……でも、でも……えっと……あ、そうだ！」",
   "voice": "nrk107_008"
  },
  {
   "file": "107・芳乃－獣耳ver1.02",
   "text": "「気分転換に、一緒に遊びに行くぐらいはできますから！」",
   "voice": "nrk107_009"
  },
  {
   "file": "107・芳乃－獣耳ver1.02",
   "text": "「えー、そんな厳しい事言わないでよー。それに実際、それ以外に出来ることってある？」",
   "voice": "nrk107_010"
  },
  {
   "file": "107・芳乃－獣耳ver1.02",
   "text": "「私ら、彼氏もいないから恋愛ごとの相談は無理でしょ？　勉強だって巫女姫様には敵わないしさー」",
   "voice": "nrk107_011"
  },
  {
   "file": "107・芳乃－獣耳ver1.02",
   "text": "「でしょー？」",
   "voice": "nrk107_012"
  },
  {
   "file": "107・芳乃－獣耳ver1.02",
   "text": "「えへへ……なんだか嬉しいね」",
   "voice": "nrk107_013"
  },
  {
   "file": "107・芳乃－獣耳ver1.02",
   "text": "「私もー」",
   "voice": "nrk107_014"
  },
  {
   "file": "107・芳乃－獣耳ver1.02",
   "text": "「あ、そうだ！　じゃあ今度、女子だけで一緒に遊びに行こー！」",
   "voice": "nrk107_015"
  },
  {
   "file": "107・芳乃－獣耳ver1.02",
   "text": "「あー……やっぱり、気が進みませんか？」",
   "voice": "nrk107_016"
  },
  {
   "file": "107・芳乃－獣耳ver1.02",
   "text": "「愚痴とか話すのなら、女子会って呼んでもいいんじゃないのー？」",
   "voice": "nrk107_017"
  },
  {
   "file": "110・芳乃－初体験ver1.01",
   "text": "「嫌がる巫女姫様を無理矢理……！？」",
   "voice": "nrk110_001"
  },
  {
   "file": "110・芳乃－初体験ver1.01",
   "text": "「そうなんですか？」",
   "voice": "nrk110_002"
  },
  {
   "file": "110・芳乃－初体験ver1.01",
   "text": "「畳神ってなに？」",
   "voice": "nrk110_003"
  },
  {
   "file": "110・芳乃－初体験ver1.01",
   "text": "「あ、私もー」",
   "voice": "nrk110_004"
  },
  {
   "file": "202・茉子－実家ver1.01",
   "text": "「そっか！　レナちゃんの言う通りだね！」",
   "voice": "nrk202_001"
  },
  {
   "file": "204・茉子－気持ちver1.00",
   "text": "「巫女姫様の結婚ともなると、親がよく話をしてますから」",
   "voice": "nrk204_001"
  },
  {
   "file": "204・茉子－気持ちver1.00",
   "text": "「それともー、理想に合う相手がいないだけですか？」",
   "voice": "nrk204_002"
  },
  {
   "file": "204・茉子－気持ちver1.00",
   "text": "「でもわたしなら、とりあえず会ってはみるかなー……そこから先は相手の条件次第」",
   "voice": "nrk204_003"
  },
  {
   "file": "204・茉子－気持ちver1.00",
   "text": "「……そう言われると、なんか印象悪い気がする」",
   "voice": "nrk204_004"
  },
  {
   "file": "204・茉子－気持ちver1.00",
   "text": "「あー、ばらさないでよ！　女子力低いのがばれちゃうじゃない！」",
   "voice": "nrk204_005"
  },
  {
   "file": "204・茉子－気持ちver1.00",
   "text": "「まー、この町で暮らしてると、都会の流行なんて追えないよね」",
   "voice": "nrk204_006"
  },
  {
   "file": "204・茉子－気持ちver1.00",
   "text": "「どうしてレナちゃんが胸を張るの……」",
   "voice": "nrk204_007"
  },
  {
   "file": "204・茉子－気持ちver1.00",
   "text": "「いいないいな～。レナちゃんって犬派？　猫派？　わたし犬派！」",
   "voice": "nrk204_008"
  },
  {
   "file": "204・茉子－気持ちver1.00",
   "text": "「あれー？　でもさっきまでそこにいたよね？」",
   "voice": "nrk204_009"
  },
  {
   "file": "204・茉子－気持ちver1.00",
   "text": "「あははー。巫女姫様も冗談を言われるんですねー。ちょっと意外で、おもしろーい」",
   "voice": "nrk204_011"
  },
  {
   "file": "204・茉子－気持ちver1.00",
   "text": "「もしかして、お腹空いてたりするのかな？」",
   "voice": "nrk204_012"
  },
  {
   "file": "204・茉子－気持ちver1.00",
   "text": "「犬にもアレルギーってあるんだ？」",
   "voice": "nrk204_013"
  },
  {
   "file": "204・茉子－気持ちver1.00",
   "text": "「にしても、常陸さんはどこかに行ったままだね」",
   "voice": "nrk204_014"
  },
  {
   "file": "301・ムラサメちゃんルート０１ver1.3",
   "text": "「ねえ、今日は外で食べない？」",
   "voice": "nrk301_001"
  }
 ]
}