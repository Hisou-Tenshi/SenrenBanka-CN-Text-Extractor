{
 "character": "白狛",
 "count": 82,
 "lines": [
  {
   "file": "414レナ・イザナウ",
   "text": "「そうは申されましても、姉君」",
   "voice": "srk414_002"
  },
  {
   "file": "414レナ・イザナウ",
   "text": "「…………」",
   "voice": "srk414_003"
  },
  {
   "file": "414レナ・イザナウ",
   "text": "「貴様、姉君ではないな」",
   "voice": "srk414_004"
  },
  {
   "file": "421レナ・玉石の女神",
   "text": "「またお小言ですか？」",
   "voice": "srk421_001"
  },
  {
   "file": "421レナ・玉石の女神",
   "text": "「そうは申されましても、姉君」",
   "voice": "srk421_002"
  },
  {
   "file": "421レナ・玉石の女神",
   "text": "「同じ穂織の山より生じたとはいえ、姉君は玉石より、私は獣より生じた神でありますれば」",
   "voice": "srk421_003"
  },
  {
   "file": "421レナ・玉石の女神",
   "text": "「なりますとも」",
   "voice": "srk421_004"
  },
  {
   "file": "421レナ・玉石の女神",
   "text": "「姉君は人より愛でられる存在なれば、人に寛容なるも必然でしょう」",
   "voice": "srk421_005"
  },
  {
   "file": "421レナ・玉石の女神",
   "text": "「しかしながら、獣は人に狩られる存在」",
   "voice": "srk421_006"
  },
  {
   "file": "421レナ・玉石の女神",
   "text": "「先日も複数の人間が、野犬に的をかけ、馬に乗って追い回しながら弓矢で射るのを見ますれば」",
   "voice": "srk421_007"
  },
  {
   "file": "421レナ・玉石の女神",
   "text": "「ご存じであるなら、私の憤激も察していただきたい」",
   "voice": "srk421_008"
  },
  {
   "file": "421レナ・玉石の女神",
   "text": "「それにいつまでも私を幼名でお呼びになるのも、おやめくださいませ」",
   "voice": "srk421_009"
  },
  {
   "file": "421レナ・玉石の女神",
   "text": "「わかりましたっ、わかりましたから！　もうお小言はおやめくださいませっ」",
   "voice": "srk421_010"
  },
  {
   "file": "421レナ・玉石の女神",
   "text": "「もしや、ご機嫌が悪いのはそれが原因で……」",
   "voice": "srk421_011"
  },
  {
   "file": "421レナ・玉石の女神",
   "text": "「……なッ！？」",
   "voice": "srk421_012"
  },
  {
   "file": "421レナ・玉石の女神",
   "text": "「わかりましたよ、姉君……」",
   "voice": "srk421_013"
  },
  {
   "file": "421レナ・玉石の女神",
   "text": "「私は、姉君には敵いませんから」",
   "voice": "srk421_014"
  },
  {
   "file": "423レナ・叢雲より生じたる",
   "text": "「姉君、なんと愚かなことを」",
   "voice": "srk423_001"
  },
  {
   "file": "423レナ・叢雲より生じたる",
   "text": "「たまたまでございます」",
   "voice": "srk423_002"
  },
  {
   "file": "423レナ・叢雲より生じたる",
   "text": "「しかし[たっと]貴き媛神が、人間に[ま]真[な]名を教えるなど聞いたことがございません」",
   "voice": "srk423_003"
  },
  {
   "file": "423レナ・叢雲より生じたる",
   "text": "「姉君……きっと、人間には想像もつかないはずです」",
   "voice": "srk423_004"
  },
  {
   "file": "423レナ・叢雲より生じたる",
   "text": "「あの刀がご自身の身を削ってまで作った物だとは、人間には想像もできないはずなのです」",
   "voice": "srk423_005"
  },
  {
   "file": "423レナ・叢雲より生じたる",
   "text": "「ではどうして？」",
   "voice": "srk423_006"
  },
  {
   "file": "423レナ・叢雲より生じたる",
   "text": "「やれやれ、いくら姉君が人間びいきでもやり過ぎというものでしょうな」",
   "voice": "srk423_007"
  },
  {
   "file": "423レナ・叢雲より生じたる",
   "text": "「……」",
   "voice": "srk423_008"
  },
  {
   "file": "423レナ・叢雲より生じたる",
   "text": "「ええ、姉君の刀を持っていたのですから、当然のことでしょうが」",
   "voice": "srk423_009"
  },
  {
   "file": "423レナ・叢雲より生じたる",
   "text": "「なんでも、見事、敵の大将格の首級を上げる大手柄とかで……」",
   "voice": "srk423_010"
  },
  {
   "file": "423レナ・叢雲より生じたる",
   "text": "「……そういった匂いはしませんでしたが」",
   "voice": "srk423_011"
  },
  {
   "file": "423レナ・叢雲より生じたる",
   "text": "「（やはり、そうだったのか）」",
   "voice": "srk423_012"
  },
  {
   "file": "423レナ・叢雲より生じたる",
   "text": "「（姉君は……人間に、恋をなさっておいでなのだ）」",
   "voice": "srk423_013"
  },
  {
   "file": "424レナ・トモダチ",
   "text": "「姉君……」",
   "voice": "srk424_001"
  },
  {
   "file": "425レナ・呪いの真実",
   "text": "「それでは、あまりに無欲というものです」",
   "voice": "srk425_001"
  },
  {
   "file": "425レナ・呪いの真実",
   "text": "「左様でございますか……」",
   "voice": "srk425_002"
  },
  {
   "file": "425レナ・呪いの真実",
   "text": "「二日経っても産まれて来ぬとは、これは助かりますまい」",
   "voice": "srk425_003"
  },
  {
   "file": "425レナ・呪いの真実",
   "text": "「おそらく御子は、[すだ]魑[ま]魅[みず]魍[は]魎の類に魂を引かれておるのでしょう」",
   "voice": "srk425_004"
  },
  {
   "file": "425レナ・呪いの真実",
   "text": "「なッ、姉君！？　冗談はやめてくださいっ」",
   "voice": "srk425_005"
  },
  {
   "file": "425レナ・呪いの真実",
   "text": "「未だ生を授からぬ子は、黄泉の国に棲まう神の持ち物なのです！」",
   "voice": "srk425_006"
  },
  {
   "file": "425レナ・呪いの真実",
   "text": "「しかも死の神は我らよりも高位であり、もし手を出せば罰を受けるのは姉君の方なのですよ！？」",
   "voice": "srk425_007"
  },
  {
   "file": "425レナ・呪いの真実",
   "text": "「姉君……な、なりません！　それだけは、本当になりませんっ」",
   "voice": "srk425_008"
  },
  {
   "file": "425レナ・呪いの真実",
   "text": "「神である我々が、神々の[ことわり]理を侵せば、もう……」",
   "voice": "srk425_009"
  },
  {
   "file": "425レナ・呪いの真実",
   "text": "「やめてください……人間など、人間などどうなってもよいではありませんか！」",
   "voice": "srk425_010"
  },
  {
   "file": "425レナ・呪いの真実",
   "text": "「しかも、あの男は姉君を裏切ったのですッ」",
   "voice": "srk425_011"
  },
  {
   "file": "425レナ・呪いの真実",
   "text": "「なのに姉君が……姉君がそこまでするなど、私はっ！　私にはもう、理解できません……」",
   "voice": "srk425_012"
  },
  {
   "file": "425レナ・呪いの真実",
   "text": "「おいたわしや、姉君……」",
   "voice": "srk425_013"
  },
  {
   "file": "425レナ・呪いの真実",
   "text": "「しかし、たとえ姿が変わり、力を失ったとて、姉君は私の姉君であられる」",
   "voice": "srk425_014"
  },
  {
   "file": "425レナ・呪いの真実",
   "text": "「姉君ができなくなってしまったことも、私が名代として遂行いたしましょう」",
   "voice": "srk425_015"
  },
  {
   "file": "425レナ・呪いの真実",
   "text": "「貴女が救った者の血脈を守る、守護者となるのです」",
   "voice": "srk425_016"
  },
  {
   "file": "425レナ・呪いの真実",
   "text": "「さすればいずれ……そこから、貴女の生まれ変わりとなるような者が現れることも考えられますからな」",
   "voice": "srk425_017"
  },
  {
   "file": "427レナ・古の祝詞",
   "text": "『やめよっ、やめよ！』",
   "voice": "srk427_002"
  },
  {
   "file": "427レナ・古の祝詞",
   "text": "「（いかん……なんとか傷つけずに、止めてやることはできんのか？）」",
   "voice": "srk427_003"
  },
  {
   "file": "427レナ・古の祝詞",
   "text": "『なッ！？』",
   "voice": "srk427_004"
  },
  {
   "file": "427レナ・古の祝詞",
   "text": "『なにをしている！？　姉君を……姉君をそのようなことに使うなッ！』",
   "voice": "srk427_005"
  },
  {
   "file": "427レナ・古の祝詞",
   "text": "『私を生け贄に、姉君を憑代にして、呪詛を施そうというのか……おおおっ、おおおおおッ！！？』",
   "voice": "srk427_006"
  },
  {
   "file": "427レナ・古の祝詞",
   "text": "『私はいいっ、私はいいから……姉君は……姉君だけは、おのれ、おのれぇ！』",
   "voice": "srk427_007"
  },
  {
   "file": "427レナ・古の祝詞",
   "text": "『姉君がどれほどの思いで、貴様らを守ってきたと思っておるのだ！　許せん、許せんっ、許せんッッ！！』",
   "voice": "srk427_008"
  },
  {
   "file": "427レナ・古の祝詞",
   "text": "『たったの数百年で、姉君から受けた大恩を忘れ果て……我らにこれほどの仕打ちをするとはッ』",
   "voice": "srk427_009"
  },
  {
   "file": "427レナ・古の祝詞",
   "text": "『もはや許し難いッ！！　決して、決して許してなるものかッ！！！』",
   "voice": "srk427_010"
  },
  {
   "file": "427レナ・古の祝詞",
   "text": "「き……貴様、まさか！」",
   "voice": "srk427_048"
  },
  {
   "file": "427レナ・古の祝詞",
   "text": "「……」",
   "voice": "srk427_049"
  },
  {
   "file": "427レナ・古の祝詞",
   "text": "「だ……黙れ、私は……私は、姉君の身代わりとして、お前を……」",
   "voice": "srk427_050"
  },
  {
   "file": "427レナ・古の祝詞",
   "text": "「違う！　それでも……それでも、私は……」",
   "voice": "srk427_051"
  },
  {
   "file": "427レナ・古の祝詞",
   "text": "「だからなんだという！　私は姉君とは違う、人が憎いっ、人が憎いのだ！」",
   "voice": "srk427_052"
  },
  {
   "file": "427レナ・古の祝詞",
   "text": "「……～ッ！？」",
   "voice": "srk427_053"
  },
  {
   "file": "427レナ・古の祝詞",
   "text": "「や……やめろっ」",
   "voice": "srk427_054"
  },
  {
   "file": "427レナ・古の祝詞",
   "text": "「綺麗事だ！　わ……私が、私がどれだけ長く、どれだけ多くの者を呪ってきたと思うのだ！？」",
   "voice": "srk427_055"
  },
  {
   "file": "427レナ・古の祝詞",
   "text": "「どれだけたくさんの者を死へ追いやっても、私はなにも感じなかった……」",
   "voice": "srk427_056"
  },
  {
   "file": "427レナ・古の祝詞",
   "text": "「憎しみは去らなかった……私は、私はただの祟り神なのだ……誰ももう、私を止められる者などいない！」",
   "voice": "srk427_057"
  },
  {
   "file": "427レナ・古の祝詞",
   "text": "「この姿であっても、貴様ら人間を屠るなど造作もないことだぞッ」",
   "voice": "srk427_058"
  },
  {
   "file": "427レナ・古の祝詞",
   "text": "「ほう、ようやくやる気になったか」",
   "voice": "srk427_059"
  },
  {
   "file": "427レナ・古の祝詞",
   "text": "「なに？　なんのつもりだ？」",
   "voice": "srk427_060"
  },
  {
   "file": "427レナ・古の祝詞",
   "text": "「なッ……なッ、もしや？」",
   "voice": "srk427_061"
  },
  {
   "file": "427レナ・古の祝詞",
   "text": "「や……やめろっ、やめろやめろ！」",
   "voice": "srk427_062"
  },
  {
   "file": "427レナ・古の祝詞",
   "text": "「嫌だ……それでも、嫌だ……許したくないッ、許したくない」",
   "voice": "srk427_063"
  },
  {
   "file": "427レナ・古の祝詞",
   "text": "「許してはいけない……私はッ、終わりになど、してはいけないのだ！」",
   "voice": "srk427_064"
  },
  {
   "file": "427レナ・古の祝詞",
   "text": "「許しなどすれば……どうせ人はすぐにまた忘れてしまう！」",
   "voice": "srk427_065"
  },
  {
   "file": "427レナ・古の祝詞",
   "text": "「なぜ恨まれるのか、なぜ呪われるのか、考えることさえなくなってしまうのだっ」",
   "voice": "srk427_066"
  },
  {
   "file": "427レナ・古の祝詞",
   "text": "「姉君から受けた恩を、誰が覚えていてくれたという！？」",
   "voice": "srk427_067"
  },
  {
   "file": "427レナ・古の祝詞",
   "text": "「それでは、こうしなくては……本当にもう、消えてなくなってしまうから……」",
   "voice": "srk427_068"
  },
  {
   "file": "427レナ・古の祝詞",
   "text": "「……祭りが、生まれ変わる？」",
   "voice": "srk427_069"
  },
  {
   "file": "427レナ・古の祝詞",
   "text": "「感謝の、祭り……姉君のために？」",
   "voice": "srk427_070"
  },
  {
   "file": "427レナ・古の祝詞",
   "text": "「自由、だと？」",
   "voice": "srk427_071"
  },
  {
   "file": "427レナ・古の祝詞",
   "text": "「……っ」",
   "voice": "srk427_072"
  }
 ]
}