{
 "character": "成美",
 "count": 75,
 "lines": [
  {
   "file": "007・レナ転入ver1.03",
   "text": "「アタシは[やぎ]柳[ゅう]生[なる]成[み]美」",
   "voice": "nrm007_004"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「あれ？　レナちゃんが、巫女姫様のことを知ってるの？」",
   "voice": "nrm007_005"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「へえ。そうなんだ」",
   "voice": "nrm007_006"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「上着はちゃんと着ないの？」",
   "voice": "nrm007_007"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「うーん、ちょっと嫌味に聞こえなくもないけど、そのサイズだもんね……。納得せざるを得ない」",
   "voice": "nrm007_008"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「噛んでる噛んでる」",
   "voice": "nrm007_009"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「流石に失礼なことはしちゃダメだけどね」",
   "voice": "nrm007_010"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「旅館で働くなら、確かに厳しいかもね」",
   "voice": "nrm007_011"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「畳と温泉ね」",
   "voice": "nrm007_012"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「へー、そうなんだ。レナちゃんってワサビは大丈夫なの？」",
   "voice": "nrm007_013"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「苦手なら苦手って言ってくれていいのに」",
   "voice": "nrm007_014"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「きっとレナちゃんのこと狙ってるのよ。気を付けて、鞍馬君は女[たら]誑しの遊び人だから」",
   "voice": "nrm007_015"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「え？　あ、うーん……なんていえばいいか……」",
   "voice": "nrm007_016"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「気を付けてね。鞍馬君の毒牙にかからないように」",
   "voice": "nrm007_017"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「あ、鞍馬君がレナちゃんに手を出そうとしてる！」",
   "voice": "nrm007_018"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「んー！　終わったー！」",
   "voice": "nrm007_019"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「旅館の休みって、結構お客様次第なところもあるからね」",
   "voice": "nrm007_020"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「また機会があったら、遊びに行こうね」",
   "voice": "nrm007_021"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「また明日ねー」",
   "voice": "nrm007_022"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「あ、巫女姫様。さようなら」",
   "voice": "nrm007_023"
  },
  {
   "file": "009・謎の欠片ver1.03",
   "text": "「ねえねえ、もしよければ、アタシたちも交換に混ぜてくれないかな？」",
   "voice": "nrm009_001"
  },
  {
   "file": "009・謎の欠片ver1.03",
   "text": "「アタシはこのハンバーグを差し出すから」",
   "voice": "nrm009_002"
  },
  {
   "file": "009・謎の欠片ver1.03",
   "text": "「あんた、そんなリクエストしないの」",
   "voice": "nrm009_003"
  },
  {
   "file": "101・芳乃－弁当ver1.02",
   "text": "「なんだか難しそうな顔をしてますよ？」",
   "voice": "nrm101_001"
  },
  {
   "file": "104・芳乃－記者会見ver1.05",
   "text": "「２年の柳生成美です。この度は結婚、おめでとうございます」",
   "voice": "nrm104_001"
  },
  {
   "file": "104・芳乃－記者会見ver1.05",
   "text": "「プロポーズはどちらから？　一体どのような言葉だったのか、教えていただけますか？」",
   "voice": "nrm104_002"
  },
  {
   "file": "104・芳乃－記者会見ver1.05",
   "text": "「我々が気になっているのはまさにそちらです！」",
   "voice": "nrm104_003"
  },
  {
   "file": "104・芳乃－記者会見ver1.05",
   "text": "「キスもまだなんだ……？」",
   "voice": "nrm104_005"
  },
  {
   "file": "107・芳乃－獣耳ver1.02",
   "text": "「何かあったの？　喧嘩？」",
   "voice": "nrm107_001"
  },
  {
   "file": "107・芳乃－獣耳ver1.02",
   "text": "「でも……なんだかちょっと、変な雰囲気じゃなかった？」",
   "voice": "nrm107_002"
  },
  {
   "file": "107・芳乃－獣耳ver1.02",
   "text": "「……まあ、常陸さんがそう言うのなら、そうなんだろうけど」",
   "voice": "nrm107_003"
  },
  {
   "file": "107・芳乃－獣耳ver1.02",
   "text": "「巫女姫様、本当に大丈夫でした？」",
   "voice": "nrm107_004"
  },
  {
   "file": "107・芳乃－獣耳ver1.02",
   "text": "「それならいいんですけど。なんだか有地君の雰囲気が怖い気がしたので……」",
   "voice": "nrm107_005"
  },
  {
   "file": "107・芳乃－獣耳ver1.02",
   "text": "「うーん……確かに今回は、心配いらなかったかもしれないけど……」",
   "voice": "nrm107_006"
  },
  {
   "file": "107・芳乃－獣耳ver1.02",
   "text": "「巫女姫様、何か困ったことがあればいつでもアタシたちに相談して下さい」",
   "voice": "nrm107_007"
  },
  {
   "file": "107・芳乃－獣耳ver1.02",
   "text": "「はい」",
   "voice": "nrm107_008"
  },
  {
   "file": "107・芳乃－獣耳ver1.02",
   "text": "「いや、アタシたちって……勝手に一括りにしないで欲しいんだけど？」",
   "voice": "nrm107_009"
  },
  {
   "file": "107・芳乃－獣耳ver1.02",
   "text": "「うっ……そ、それはそうだ。まともなアドバイスなんてできそうにないかも……」",
   "voice": "nrm107_010"
  },
  {
   "file": "107・芳乃－獣耳ver1.02",
   "text": "「アタシらに出来ることって……話を聞いて、気分転換に付き合うだけかも」",
   "voice": "nrm107_011"
  },
  {
   "file": "107・芳乃－獣耳ver1.02",
   "text": "「すみません、巫女姫様。アタシら、全然お役に立てそうになくて」",
   "voice": "nrm107_012"
  },
  {
   "file": "107・芳乃－獣耳ver1.02",
   "text": "「そ、そうですか？　そう言ってもらえると、嬉しいですけど」",
   "voice": "nrm107_013"
  },
  {
   "file": "107・芳乃－獣耳ver1.02",
   "text": "「まさか巫女姫様にそんな風に言ってもらえるなんて……ちょっとビックリ」",
   "voice": "nrm107_014"
  },
  {
   "file": "107・芳乃－獣耳ver1.02",
   "text": "「悩みでも愚痴でも何でも、話を聞くぐらいならいつでも付き合いますから」",
   "voice": "nrm107_015"
  },
  {
   "file": "107・芳乃－獣耳ver1.02",
   "text": "「そうだね、それもいいかもね。巫女姫様さえよければ……ですけど」",
   "voice": "nrm107_016"
  },
  {
   "file": "107・芳乃－獣耳ver1.02",
   "text": "「え？　そうなんですか」",
   "voice": "nrm107_017"
  },
  {
   "file": "107・芳乃－獣耳ver1.02",
   "text": "「女子会……って言っていいのかな？　なんか、働いてる人がやってるイメージだけど」",
   "voice": "nrm107_018"
  },
  {
   "file": "107・芳乃－獣耳ver1.02",
   "text": "「まあ、そっか。じゃあ今度、女子会を開きましょう」",
   "voice": "nrm107_019"
  },
  {
   "file": "110・芳乃－初体験ver1.01",
   "text": "「もしかして、有地君が迫ったとか？」",
   "voice": "nrm110_001"
  },
  {
   "file": "110・芳乃－初体験ver1.01",
   "text": "「それならいいんですけど……」",
   "voice": "nrm110_002"
  },
  {
   "file": "110・芳乃－初体験ver1.01",
   "text": "「さ、さあ？　畳の神様……かな？」",
   "voice": "nrm110_003"
  },
  {
   "file": "110・芳乃－初体験ver1.01",
   "text": "「前にもいいましたけど、愚痴でもなんでも聞きますからね」",
   "voice": "nrm110_004"
  },
  {
   "file": "202・茉子－実家ver1.01",
   "text": "「今日も巫女姫様のお弁当は美味しそうですね」",
   "voice": "nrm202_001"
  },
  {
   "file": "204・茉子－気持ちver1.00",
   "text": "「そう言えば、巫女姫様。またお見合いを断ったらしいですね」",
   "voice": "nrm204_001"
  },
  {
   "file": "204・茉子－気持ちver1.00",
   "text": "「わりとすぐに、住人の間では噂になってますよ」",
   "voice": "nrm204_002"
  },
  {
   "file": "204・茉子－気持ちver1.00",
   "text": "「巫女姫様は、お見合いが嫌いなんですか？　もっと普通の出会い方がしたいとか？」",
   "voice": "nrm204_003"
  },
  {
   "file": "204・茉子－気持ちver1.00",
   "text": "「そうなんですか……でも確かに、まだ学生ですもんね」",
   "voice": "nrm204_004"
  },
  {
   "file": "204・茉子－気持ちver1.00",
   "text": "「この子、適当に言ってるだけですから、本気にしないで下さい」",
   "voice": "nrm204_005"
  },
  {
   "file": "204・茉子－気持ちver1.00",
   "text": "「こんなこと言ってますけど、誰かと付き合った経験があるわけじゃないんですよ」",
   "voice": "nrm204_006"
  },
  {
   "file": "204・茉子－気持ちver1.00",
   "text": "「だから何度も言ってるけど……処女捨てた年齢で女子力が決まるわけじゃないから」",
   "voice": "nrm204_007"
  },
  {
   "file": "204・茉子－気持ちver1.00",
   "text": "「何って訊かれると、アタシも詳しいことは知らないけど」",
   "voice": "nrm204_008"
  },
  {
   "file": "204・茉子－気持ちver1.00",
   "text": "「身につけられる女としての魅力……って言えばいいのかな？」",
   "voice": "nrm204_009"
  },
  {
   "file": "204・茉子－気持ちver1.00",
   "text": "「流行に敏感とか、化粧が上手とか……あと、料理なんかの家事全般ができると、女子力高いイメージがあるけど」",
   "voice": "nrm204_010"
  },
  {
   "file": "204・茉子－気持ちver1.00",
   "text": "「でも料理もできるし、部屋も綺麗にしてそうだし、確かに女子力かなり高いかも……」",
   "voice": "nrm204_011"
  },
  {
   "file": "204・茉子－気持ちver1.00",
   "text": "「というか……本当、相変わらずすっごい胸」",
   "voice": "nrm204_012"
  },
  {
   "file": "204・茉子－気持ちver1.00",
   "text": "「あ、本当だ。いつの間に入ってきたんだろう？」",
   "voice": "nrm204_013"
  },
  {
   "file": "204・茉子－気持ちver1.00",
   "text": "「よーしよしよし」",
   "voice": "nrm204_014"
  },
  {
   "file": "204・茉子－気持ちver1.00",
   "text": "「可愛いけど……この子、いつの間に入ってきたんだろう？」",
   "voice": "nrm204_015"
  },
  {
   "file": "204・茉子－気持ちver1.00",
   "text": "「巫女姫様と常陸さんは――って、あれ？　常陸さんは？」",
   "voice": "nrm204_016"
  },
  {
   "file": "204・茉子－気持ちver1.00",
   "text": "「常陸さんがいないみたいだけど」",
   "voice": "nrm204_017"
  },
  {
   "file": "204・茉子－気持ちver1.00",
   "text": "「なにか、お昼の残りとかあったかな？」",
   "voice": "nrm204_019"
  },
  {
   "file": "204・茉子－気持ちver1.00",
   "text": "「へぇ、そうなんだ？」",
   "voice": "nrm204_020"
  },
  {
   "file": "204・茉子－気持ちver1.00",
   "text": "「なんか詳しいね。昔飼ってたとか？」",
   "voice": "nrm204_021"
  },
  {
   "file": "204・茉子－気持ちver1.00",
   "text": "「それはわかってますけど……なんで巫女姫様、そんなに必死なんです？」",
   "voice": "nrm204_022"
  },
  {
   "file": "206・茉子－オナニーver1.00",
   "text": "「どういうことなんですか、巫女姫様？」",
   "voice": "nrm206_001"
  },
  {
   "file": "301・ムラサメちゃんルート０１ver1.3",
   "text": "「あ～、お昼だーっ」",
   "voice": "nrm301_001"
  }
 ]
}