{
 "character": "オヤジ",
 "count": 13,
 "lines": [
  {
   "file": "003・巫女の秘密ver1.11",
   "text": "「よう、茉子ちゃん！　夕食の買い物かい？　春キャベツ、どうだい？」",
   "voice": "oyj003_001"
  },
  {
   "file": "003・巫女の秘密ver1.11",
   "text": "「あとオレンジも付けるから、是非食べてくれ」",
   "voice": "oyj003_002"
  },
  {
   "file": "003・巫女の秘密ver1.11",
   "text": "「ああ。祭りでの巫女姫様の舞、今年も美しかったからな。来年も楽しみにしてるって伝えておいてくれ」",
   "voice": "oyj003_003"
  },
  {
   "file": "104・芳乃－記者会見ver1.05",
   "text": "「まったくですな！　わはははは！」",
   "voice": "oyj104_001"
  },
  {
   "file": "104・芳乃－記者会見ver1.05",
   "text": "「茉子ちゃーん、お銚子お代わり～」",
   "voice": "oyj104_002"
  },
  {
   "file": "104・芳乃－記者会見ver1.05",
   "text": "「いよ！　だいとーりょー！　わはははは！」",
   "voice": "oyj104_003"
  },
  {
   "file": "104・芳乃－記者会見ver1.05",
   "text": "「これなら俺の方がいい男なんじゃないのか？　立候補した方がよかったか？」",
   "voice": "oyj104_004"
  },
  {
   "file": "104・芳乃－記者会見ver1.05",
   "text": "「それから今後の話！　式の日取りはいつにするんです？」",
   "voice": "oyj104_005"
  },
  {
   "file": "104・芳乃－記者会見ver1.05",
   "text": "「いやいや、きっと婿殿は緊張しているんですよ」",
   "voice": "oyj104_006"
  },
  {
   "file": "104・芳乃－記者会見ver1.05",
   "text": "「緊張をほぐすためにもジュースを飲むといいですよ。ほらほら、コップを持って持って」",
   "voice": "oyj104_007"
  },
  {
   "file": "104・芳乃－記者会見ver1.05",
   "text": "「だからジュースですよ、お米のジュース」",
   "voice": "oyj104_008"
  },
  {
   "file": "104・芳乃－記者会見ver1.05",
   "text": "「ささ！　もう一杯グイッとグイッと」",
   "voice": "oyj104_009"
  },
  {
   "file": "106・芳乃－キスver1.01",
   "text": "「………」",
   "voice": "oyj106_001"
  }
 ]
}