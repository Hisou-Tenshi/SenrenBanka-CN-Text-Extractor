{
 "character": "オッサン",
 "count": 14,
 "lines": [
  {
   "file": "003・巫女の秘密ver1.11",
   "text": "「おっ、茉子ちゃん。いらっしゃい。夕食の買い物かい？」",
   "voice": "osn003_001"
  },
  {
   "file": "003・巫女の秘密ver1.11",
   "text": "「ウチのは全部お勧めだよ。知ってるだろ？　けど、そうだなー……今日は豚肉なんてどうだい？」",
   "voice": "osn003_002"
  },
  {
   "file": "003・巫女の秘密ver1.11",
   "text": "「巫女姫様もお疲れが残っているんじゃないか？　疲労回復には豚肉がいいって言うしな」",
   "voice": "osn003_003"
  },
  {
   "file": "003・巫女の秘密ver1.11",
   "text": "「あいよ。いつもの量でいいよな？」",
   "voice": "osn003_004"
  },
  {
   "file": "003・巫女の秘密ver1.11",
   "text": "「お？　なんだ？　巫女姫様はそんなにお疲れかい？　本当に大丈夫か？　心配だな……」",
   "voice": "osn003_005"
  },
  {
   "file": "003・巫女の秘密ver1.11",
   "text": "「よし、コロッケをおまけにつけよう！　ウチのコロッケを食べて、一日でも早く元気になってくれるようにな！」",
   "voice": "osn003_006"
  },
  {
   "file": "003・巫女の秘密ver1.11",
   "text": "「なんだ、そうだったのか。でもま、男が一度言ったことだ。コロッケは持って帰って食べてくれ」",
   "voice": "osn003_007"
  },
  {
   "file": "003・巫女の秘密ver1.11",
   "text": "「巫女姫様によろしくな」",
   "voice": "osn003_008"
  },
  {
   "file": "104・芳乃－記者会見ver1.05",
   "text": "「わはははは！　いやー、めでたいですなー！　今日ほど酒が美味いと思えた日はありませんよ」",
   "voice": "osn104_001"
  },
  {
   "file": "104・芳乃－記者会見ver1.05",
   "text": "「お！　婿殿だ！　主役のお目見えだ！」",
   "voice": "osn104_002"
  },
  {
   "file": "104・芳乃－記者会見ver1.05",
   "text": "「こんな男の何がよかったんだろうな？」",
   "voice": "osn104_003"
  },
  {
   "file": "104・芳乃－記者会見ver1.05",
   "text": "「そうそう！　２人のなれ初めとか！」",
   "voice": "osn104_004"
  },
  {
   "file": "106・芳乃－キスver1.01",
   "text": "「おっ、なんだ巫女姫様とデートか、やるねぇ！」",
   "voice": "osn106_001"
  },
  {
   "file": "302・ムラサメちゃんルート０２ver1.3",
   "text": "「あいよ！　一番、新鮮でいいのを届けるよ！」",
   "voice": "osn302_001"
  }
 ]
}