{
 "character": "ママ",
 "count": 12,
 "lines": [
  {
   "file": "414レナ・イザナウ",
   "text": "「そうよ、お母さんもお仕事休んで来ちゃったわ」",
   "voice": "mam414_001"
  },
  {
   "file": "414レナ・イザナウ",
   "text": "「私達、家族旅行へ来たんじゃない」",
   "voice": "mam414_002"
  },
  {
   "file": "414レナ・イザナウ",
   "text": "「ふふふふ、ありがとうレナ」",
   "voice": "mam414_003"
  },
  {
   "file": "414レナ・イザナウ",
   "text": "「だって、レナの大好きなものを集めたのだから当たり前でしょう？」",
   "voice": "mam414_004"
  },
  {
   "file": "414レナ・イザナウ",
   "text": "「愛してるわよ、レナ」",
   "voice": "mam414_005"
  },
  {
   "file": "414レナ・イザナウ",
   "text": "「本当に？」",
   "voice": "mam414_006"
  },
  {
   "file": "414レナ・イザナウ",
   "text": "「ええ、そうね」",
   "voice": "mam414_007"
  },
  {
   "file": "414レナ・イザナウ",
   "text": "「さあ、早くいただきましょう。どのお料理も、とっても美味しそうよ」",
   "voice": "mam414_009"
  },
  {
   "file": "414レナ・イザナウ",
   "text": "「ええ、ちょっとだけ」",
   "voice": "mam414_010"
  },
  {
   "file": "414レナ・イザナウ",
   "text": "「そうだ、仲居さんにお箸の使い方を教えて欲しいわ」",
   "voice": "mam414_011"
  },
  {
   "file": "414レナ・イザナウ",
   "text": "「どうしたの、早く見たいわ？」",
   "voice": "mam414_012"
  },
  {
   "file": "414レナ・イザナウ",
   "text": "「どうしたの、レナ」",
   "voice": "mam414_013"
  }
 ]
}