{
 "character": "都子",
 "count": 7,
 "lines": [
  {
   "file": "114・芳乃－ＥＰver1.01",
   "text": "「こんな可愛い子が、娘になってくれるなんて！」",
   "voice": "myk114_001"
  },
  {
   "file": "114・芳乃－ＥＰver1.01",
   "text": "「実はこんな可愛げのない息子じゃなくて、ずっと娘が欲しかったの！」",
   "voice": "myk114_002"
  },
  {
   "file": "316・ムラサメちゃんルート１６ver1.2",
   "text": "「私は母の有地都子です。いつも息子がお世話になってます」",
   "voice": "myk316_001"
  },
  {
   "file": "316・ムラサメちゃんルート１６ver1.2",
   "text": "「それにしても、本当に可愛らしいお嬢さんね」",
   "voice": "myk316_002"
  },
  {
   "file": "316・ムラサメちゃんルート１６ver1.2",
   "text": "「まるで日本人形みたいだわ」",
   "voice": "myk316_003"
  },
  {
   "file": "316・ムラサメちゃんルート１６ver1.2",
   "text": "「まったく、この子はまだ本人にも言ってなかったの？」",
   "voice": "myk316_004"
  },
  {
   "file": "316・ムラサメちゃんルート１６ver1.2",
   "text": "「私は、お義母さんと呼んでね、ムラサメちゃん」",
   "voice": "myk316_005"
  }
 ]
}