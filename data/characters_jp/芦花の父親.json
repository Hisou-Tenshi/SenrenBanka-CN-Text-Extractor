{
 "character": "芦花の父親",
 "count": 124,
 "lines": [
  {
   "file": "103・芳乃－氷解ver1.04",
   "text": "「断る」",
   "voice": "rkc103_001"
  },
  {
   "file": "103・芳乃－氷解ver1.04",
   "text": "「店の仕事だって重要だ」",
   "voice": "rkc103_002"
  },
  {
   "file": "103・芳乃－氷解ver1.04",
   "text": "「とにかく教えるつもりはない。仕事が詰まってんだ」",
   "voice": "rkc103_003"
  },
  {
   "file": "103・芳乃－氷解ver1.04",
   "text": "「今から午後用にプリンを追加で作らなきゃいけねえんだ。素人に優しく料理教室を開いてる暇はない」",
   "voice": "rkc103_004"
  },
  {
   "file": "103・芳乃－氷解ver1.04",
   "text": "「親に向かってなんだその口の利き方はっ」",
   "voice": "rkc103_005"
  },
  {
   "file": "103・芳乃－氷解ver1.04",
   "text": "「無駄口叩いてないでお前も働け。ほら、パフェの注文が来てるぞ」",
   "voice": "rkc103_006"
  },
  {
   "file": "103・芳乃－氷解ver1.04",
   "text": "「厨房で、でかい声を出すな」",
   "voice": "rkc103_007"
  },
  {
   "file": "103・芳乃－氷解ver1.04",
   "text": "「まっ、こんなもんだろ」",
   "voice": "rkc103_008"
  },
  {
   "file": "103・芳乃－氷解ver1.04",
   "text": "「用が終わったならさっさと出てけ」",
   "voice": "rkc103_009"
  },
  {
   "file": "417レナ・エニシ",
   "text": "「いい加減にしろ、芦花」",
   "voice": "rkc417_001"
  },
  {
   "file": "417レナ・エニシ",
   "text": "「そんなもの、物珍しさで１度注文してもらえたって、２度注文する客はいない」",
   "voice": "rkc417_002"
  },
  {
   "file": "417レナ・エニシ",
   "text": "「とにかくオレは、そんなもの作るのはお断りだ」",
   "voice": "rkc417_003"
  },
  {
   "file": "417レナ・エニシ",
   "text": "「なんでもやるという意味じゃない。お断りと言ったら、お断りだ！」",
   "voice": "rkc417_004"
  },
  {
   "file": "417レナ・エニシ",
   "text": "「いや、いい。レナちゃんだっけ？」",
   "voice": "rkc417_005"
  },
  {
   "file": "417レナ・エニシ",
   "text": "「失敗は失敗だ、芦花が一番わかってる」",
   "voice": "rkc417_006"
  },
  {
   "file": "417レナ・エニシ",
   "text": "「バカ野郎」",
   "voice": "rkc417_007"
  },
  {
   "file": "417レナ・エニシ",
   "text": "「だが、ちょっとばかり意地になりすぎた、すまん」",
   "voice": "rkc417_008"
  },
  {
   "file": "417レナ・エニシ",
   "text": "「こういうのは、他の店も試したところがいくらでもある」",
   "voice": "rkc417_009"
  },
  {
   "file": "417レナ・エニシ",
   "text": "「だが色物系の名物は、地域全体であちこちの店の看板に出てるくらいじゃないと上手くいかない」",
   "voice": "rkc417_010"
  },
  {
   "file": "417レナ・エニシ",
   "text": "「いや、一度看板を見て気になっても、美味いかどうかわからない物にはなかなか金を出しづらいだろう？」",
   "voice": "rkc417_011"
  },
  {
   "file": "417レナ・エニシ",
   "text": "「だが２度３度、同じ看板が出てるのを見たら、ひょっとしたら美味いのかって気になってくる」",
   "voice": "rkc417_012"
  },
  {
   "file": "417レナ・エニシ",
   "text": "「それでようやく金を落としてくれるものなんだ」",
   "voice": "rkc417_013"
  },
  {
   "file": "417レナ・エニシ",
   "text": "「だから、ウチの店だけでやっても大して売れたりしないもんなんだよ」",
   "voice": "rkc417_014"
  },
  {
   "file": "417レナ・エニシ",
   "text": "「それじゃ試行錯誤しないうちに、やめちまったんじゃないのか？」",
   "voice": "rkc417_015"
  },
  {
   "file": "417レナ・エニシ",
   "text": "「失敗は失敗でもなにがいけなかったのか、なんで反対されてるのか」",
   "voice": "rkc417_016"
  },
  {
   "file": "417レナ・エニシ",
   "text": "「自分で経験して考えなきゃ、身につかないもんなんだ」",
   "voice": "rkc417_017"
  },
  {
   "file": "417レナ・エニシ",
   "text": "「バカ野郎、だから最近の若いヤツはダメなんだよ！」",
   "voice": "rkc417_018"
  },
  {
   "file": "417レナ・エニシ",
   "text": "「オレが修行してた頃は、技を盗もうと師匠の手元ばっかり見てたら、ぶん殴られたもんだよ」",
   "voice": "rkc417_019"
  },
  {
   "file": "417レナ・エニシ",
   "text": "「……なに？」",
   "voice": "rkc417_020"
  },
  {
   "file": "417レナ・エニシ",
   "text": "「ほう、ＳＬか！　そんな話をされたのは、ひさしぶりだな」",
   "voice": "rkc417_021"
  },
  {
   "file": "417レナ・エニシ",
   "text": "「なにを言ってる？　向こうから聞いてくれたんじゃないか」",
   "voice": "rkc417_022"
  },
  {
   "file": "417レナ・エニシ",
   "text": "「もちろんだ！　線路だってすぐ近くまで来てたくらいだからな、間違いない」",
   "voice": "rkc417_023"
  },
  {
   "file": "417レナ・エニシ",
   "text": "「それも国鉄が走らせていた旧式のイギリス製ではなく、ぴっかぴかのドイツ製だったんだぞ！」",
   "voice": "rkc417_024"
  },
  {
   "file": "417レナ・エニシ",
   "text": "「ああ、国鉄がイギリス製だったのは、蒸気機関車のコピー生産を許してくれたのがイギリスだけだったからだ」",
   "voice": "rkc417_025"
  },
  {
   "file": "417レナ・エニシ",
   "text": "「夢の国産ＳＬを産み出すため、必死に製造技術を学ぼうとしていた時期だからな」",
   "voice": "rkc417_026"
  },
  {
   "file": "417レナ・エニシ",
   "text": "「だが地方の私鉄には関係ない」",
   "voice": "rkc417_027"
  },
  {
   "file": "417レナ・エニシ",
   "text": "「ドイツ製は、小型で馬力が強く、しかも安かった」",
   "voice": "rkc417_028"
  },
  {
   "file": "417レナ・エニシ",
   "text": "「だから当時の私鉄はほとんどがドイツ製だ、間違いないだろう」",
   "voice": "rkc417_029"
  },
  {
   "file": "417レナ・エニシ",
   "text": "「へー、凄いじゃないか！　だが、さすがにそこまではわからんな」",
   "voice": "rkc417_030"
  },
  {
   "file": "417レナ・エニシ",
   "text": "「でも、そういうこともあったかもな」",
   "voice": "rkc417_031"
  },
  {
   "file": "417レナ・エニシ",
   "text": "「いや、きっとあったろう！　当時、鉄道を通すというのは、最先端の技術を結集した大変な事業だった」",
   "voice": "rkc417_032"
  },
  {
   "file": "417レナ・エニシ",
   "text": "「外国から人を招くくらいしなくては、日本人だけではとても成し得なかったはずだ」",
   "voice": "rkc417_033"
  },
  {
   "file": "502・サブ－アルバイトver1.00",
   "text": "「なんだ？」",
   "voice": "rkc502_001"
  },
  {
   "file": "502・サブ－アルバイトver1.00",
   "text": "「この店にも、何度か来ていたな」",
   "voice": "rkc502_002"
  },
  {
   "file": "502・サブ－アルバイトver1.00",
   "text": "「よろしく頼む」",
   "voice": "rkc502_003"
  },
  {
   "file": "502・サブ－アルバイトver1.00",
   "text": "「ああ、わかった。そう気張らなくていい」",
   "voice": "rkc502_004"
  },
  {
   "file": "502・サブ－アルバイトver1.00",
   "text": "「じゃあ、早速はじめるか。こっちに来てくれ」",
   "voice": "rkc502_005"
  },
  {
   "file": "502・サブ－アルバイトver1.00",
   "text": "「おい、白玉団子、ゆでてくれ」",
   "voice": "rkc502_006"
  },
  {
   "file": "502・サブ－アルバイトver1.00",
   "text": "「難しいもんじゃない。団子は俺が作るから、お湯を沸かせておいてくれ」",
   "voice": "rkc502_007"
  },
  {
   "file": "502・サブ－アルバイトver1.00",
   "text": "「ああ……いいだろう。ありがとう」",
   "voice": "rkc502_008"
  },
  {
   "file": "502・サブ－アルバイトver1.00",
   "text": "「そっち、任せるぞ」",
   "voice": "rkc502_009"
  },
  {
   "file": "504・サブ－芦花の目覚めver1.00",
   "text": "「………」",
   "voice": "rkc504_001"
  },
  {
   "file": "504・サブ－芦花の目覚めver1.00",
   "text": "「ふんっ……珈琲なんて、ずずっ」",
   "voice": "rkc504_002"
  },
  {
   "file": "504・サブ－芦花の目覚めver1.00",
   "text": "「……んっ、ほぉぅ……」",
   "voice": "rkc504_003"
  },
  {
   "file": "504・サブ－芦花の目覚めver1.00",
   "text": "「……やっぱり邪道だな」",
   "voice": "rkc504_004"
  },
  {
   "file": "504・サブ－芦花の目覚めver1.00",
   "text": "「そっ、そんな息、出してねぇよ、バカ言うな」",
   "voice": "rkc504_005"
  },
  {
   "file": "504・サブ－芦花の目覚めver1.00",
   "text": "「……味は……悪くはないな。以前の苦いだけのものとは違う」",
   "voice": "rkc504_006"
  },
  {
   "file": "504・サブ－芦花の目覚めver1.00",
   "text": "「インスタントとは全然違うもんだな」",
   "voice": "rkc504_007"
  },
  {
   "file": "504・サブ－芦花の目覚めver1.00",
   "text": "「……社長はお前だ、好きにしろ」",
   "voice": "rkc504_008"
  },
  {
   "file": "504・サブ－芦花の目覚めver1.00",
   "text": "「反応が悪かったら、すぐに止めろよ」",
   "voice": "rkc504_009"
  },
  {
   "file": "504・サブ－芦花の目覚めver1.00",
   "text": "「それがわかってるなら、やってみればいいんじゃないか」",
   "voice": "rkc504_010"
  },
  {
   "file": "504・サブ－芦花の目覚めver1.00",
   "text": "「ただし、味についてはもう少し考えてみたいが」",
   "voice": "rkc504_011"
  },
  {
   "file": "504・サブ－芦花の目覚めver1.00",
   "text": "「全体的に濃くないか？　もう少し薄味の方が、甘味を邪魔しないんじゃないかと思うんだが」",
   "voice": "rkc504_012"
  },
  {
   "file": "504・サブ－芦花の目覚めver1.00",
   "text": "「ほら、浮かれてないで、とっとと店を開ける準備をしろ」",
   "voice": "rkc504_013"
  },
  {
   "file": "506・サブ－恋愛協定ver1.00",
   "text": "「見てわかるだろ、煎餅だ、煎餅」",
   "voice": "rkc506_001"
  },
  {
   "file": "506・サブ－恋愛協定ver1.00",
   "text": "「丁度いい。そっちのは全部出来上がってるから、運んじまってくれ」",
   "voice": "rkc506_002"
  },
  {
   "file": "506・サブ－恋愛協定ver1.00",
   "text": "「別に店で出せとは言ってないぞ」",
   "voice": "rkc506_003"
  },
  {
   "file": "506・サブ－恋愛協定ver1.00",
   "text": "「今さら煎餅がバカ売れする時代でもないだろうしな」",
   "voice": "rkc506_004"
  },
  {
   "file": "506・サブ－恋愛協定ver1.00",
   "text": "「今の店の客層には合わないだろう。ケーキやらなんやらの生菓子を開発する方が店には合う」",
   "voice": "rkc506_005"
  },
  {
   "file": "506・サブ－恋愛協定ver1.00",
   "text": "「お前が新しい客を呼んだおかげで、少しは店も楽になりつつあるからな」",
   "voice": "rkc506_006"
  },
  {
   "file": "506・サブ－恋愛協定ver1.00",
   "text": "「けどな、以前からいてくれるお客も大事にしたい。そういう人のために、伝統の味ってやつを残したいと思ったんだよ」",
   "voice": "rkc506_007"
  },
  {
   "file": "506・サブ－恋愛協定ver1.00",
   "text": "「まあ、邪魔になるなら無理強いするつもりはない」",
   "voice": "rkc506_008"
  },
  {
   "file": "506・サブ－恋愛協定ver1.00",
   "text": "「ああ、試作品だ。是非食ってみてくれ」",
   "voice": "rkc506_009"
  },
  {
   "file": "506・サブ－恋愛協定ver1.00",
   "text": "「そ、そうか……けど、煎餅なんて古めかしくて、若い子は興味ないだろ？」",
   "voice": "rkc506_010"
  },
  {
   "file": "506・サブ－恋愛協定ver1.00",
   "text": "「そ、そうか……そう言ってもらえると、嬉しいもんだな」",
   "voice": "rkc506_011"
  },
  {
   "file": "506・サブ－恋愛協定ver1.00",
   "text": "「……いいのか？」",
   "voice": "rkc506_012"
  },
  {
   "file": "506・サブ－恋愛協定ver1.00",
   "text": "「なんだ……今日はやけに素直だな」",
   "voice": "rkc506_013"
  },
  {
   "file": "506・サブ－恋愛協定ver1.00",
   "text": "「嘘吐け、この意地っ張り。なんだ将臣君に言われたから、そんな素直に折れるのか？」",
   "voice": "rkc506_014"
  },
  {
   "file": "506・サブ－恋愛協定ver1.00",
   "text": "「ありがとうな、将臣君」",
   "voice": "rkc506_015"
  },
  {
   "file": "506・サブ－恋愛協定ver1.00",
   "text": "「そういうことじゃない。芦花のことだ」",
   "voice": "rkc506_016"
  },
  {
   "file": "506・サブ－恋愛協定ver1.00",
   "text": "「アイツは、卒業してすぐにこの店を継いだからな。肩肘を張ってたんだ」",
   "voice": "rkc506_017"
  },
  {
   "file": "506・サブ－恋愛協定ver1.00",
   "text": "「手探りで進めて、失敗もして、端から見ててもわかるぐらい悩んでいた」",
   "voice": "rkc506_018"
  },
  {
   "file": "506・サブ－恋愛協定ver1.00",
   "text": "「けど今回の珈琲の一件で、少しは自信が持てたんだろう。多少は余裕ができたみたいだ」",
   "voice": "rkc506_019"
  },
  {
   "file": "506・サブ－恋愛協定ver1.00",
   "text": "「誰かに背中を押してもらうっていうのが重要だったんだ。けど、それは俺じゃあダメだ」",
   "voice": "rkc506_020"
  },
  {
   "file": "506・サブ－恋愛協定ver1.00",
   "text": "「アイツは意地っ張りだからな。俺が変に口をはさむと、情けだと思って余計に意固地になる」",
   "voice": "rkc506_021"
  },
  {
   "file": "506・サブ－恋愛協定ver1.00",
   "text": "「だから、ありがとうな」",
   "voice": "rkc506_022"
  },
  {
   "file": "506・サブ－恋愛協定ver1.00",
   "text": "「アイツにとって、きっと君は頼れる存在なんだろう」",
   "voice": "rkc506_023"
  },
  {
   "file": "506・サブ－恋愛協定ver1.00",
   "text": "「どうでもいい人間に言われた言葉で、動かされるような奴じゃないからな」",
   "voice": "rkc506_024"
  },
  {
   "file": "507・サブ－選択肢ver1.00",
   "text": "「煎餅を焼きたい？」",
   "voice": "rkc507_001"
  },
  {
   "file": "507・サブ－選択肢ver1.00",
   "text": "「……まっ、いいだろう。タネもあるしな」",
   "voice": "rkc507_002"
  },
  {
   "file": "507・サブ－選択肢ver1.00",
   "text": "「商品展開を考えるなら、醤油だけじゃなく味のバリエーションが必要だからな」",
   "voice": "rkc507_003"
  },
  {
   "file": "507・サブ－選択肢ver1.00",
   "text": "「若い奴の知識は必要だ。それに……伝統を引き継がせるのも悪くないもんだ」",
   "voice": "rkc507_004"
  },
  {
   "file": "507・サブ－選択肢ver1.00",
   "text": "「これは、なかなかいい出来だな」",
   "voice": "rkc507_005"
  },
  {
   "file": "507・サブ－選択肢ver1.00",
   "text": "「それを差し引いても、初めてにしちゃ上出来だ」",
   "voice": "rkc507_006"
  },
  {
   "file": "507・サブ－選択肢ver1.00",
   "text": "「バリエーションを増やすときには期待できそうだな」",
   "voice": "rkc507_007"
  },
  {
   "file": "507・サブ－選択肢ver1.00",
   "text": "「これは、なかなかいい出来だな」",
   "voice": "rkc507_005_ref"
  },
  {
   "file": "508a・サブ－こはるんver1.00",
   "text": "「……んっ……うん。焼き加減はこんなものだろう」",
   "voice": "rkc508_001"
  },
  {
   "file": "508a・サブ－こはるんver1.00",
   "text": "「最初から結構うまかったけど、これなら十分売り物にもできる」",
   "voice": "rkc508_002"
  },
  {
   "file": "508a・サブ－こはるんver1.00",
   "text": "「しかし……醤油と味噌じゃあ、最近の客に受けるか？」",
   "voice": "rkc508_003"
  },
  {
   "file": "508a・サブ－こはるんver1.00",
   "text": "「ああ、和三盆で作れるな。下地には塩を使って、甘辛く調節できれば……」",
   "voice": "rkc508_004"
  },
  {
   "file": "508a・サブ－こはるんver1.00",
   "text": "「いや、そこまでかからねえよ」",
   "voice": "rkc508_005"
  },
  {
   "file": "508a・サブ－こはるんver1.00",
   "text": "「ああ。大丈夫だ」",
   "voice": "rkc508_006"
  },
  {
   "file": "511・サブ－小春（初体験）ver1.00",
   "text": "「こんなものか、お疲れさん」",
   "voice": "rkc511_001"
  },
  {
   "file": "511・サブ－小春（初体験）ver1.00",
   "text": "「ん？　なんだ？」",
   "voice": "rkc511_002"
  },
  {
   "file": "511・サブ－小春（初体験）ver1.00",
   "text": "「今からか？」",
   "voice": "rkc511_003"
  },
  {
   "file": "511・サブ－小春（初体験）ver1.00",
   "text": "「そうだな……触るのが煎餅だけなら、まあいいだろう。タネも少し余ってるからな」",
   "voice": "rkc511_004"
  },
  {
   "file": "511・サブ－小春（初体験）ver1.00",
   "text": "「あとは、社長の判断に任せる」",
   "voice": "rkc511_005"
  },
  {
   "file": "521・サブ－芦花（初体験）ver1.00",
   "text": "「それじゃあ、俺たちも上がるか」",
   "voice": "rkc521_001"
  },
  {
   "file": "521・サブ－芦花（初体験）ver1.00",
   "text": "「じゃあ、お疲れさん」",
   "voice": "rkc521_002"
  },
  {
   "file": "522・サブ－芦花（その後）ver1.00",
   "text": "「んっ……」",
   "voice": "rkc522_001"
  },
  {
   "file": "522・サブ－芦花（その後）ver1.00",
   "text": "「シャーベットよりもカキ氷に近いんだな」",
   "voice": "rkc522_002"
  },
  {
   "file": "522・サブ－芦花（その後）ver1.00",
   "text": "「少し甘めの桃に……この余韻は梅か」",
   "voice": "rkc522_003"
  },
  {
   "file": "522・サブ－芦花（その後）ver1.00",
   "text": "「梅の主張は控えめで、桃との甘さもバランスもいい。ほのかに甘く、梅のいい香りが余韻としてあるな」",
   "voice": "rkc522_004"
  },
  {
   "file": "522・サブ－芦花（その後）ver1.00",
   "text": "「果物は桃だけか？」",
   "voice": "rkc522_005"
  },
  {
   "file": "522・サブ－芦花（その後）ver1.00",
   "text": "「………」",
   "voice": "rkc522_006"
  },
  {
   "file": "522・サブ－芦花（その後）ver1.00",
   "text": "「まあ……いいだろう。これからの季節には、こういうサッパリしたものが喜ばれるからな」",
   "voice": "rkc522_007"
  },
  {
   "file": "522・サブ－芦花（その後）ver1.00",
   "text": "「試してみてもいいんじゃないか？」",
   "voice": "rkc522_008"
  },
  {
   "file": "522・サブ－芦花（その後）ver1.00",
   "text": "「とりあえずな。夏に出してみて、お客さんの反応を見ればいい」",
   "voice": "rkc522_009"
  },
  {
   "file": "522・サブ－芦花（その後）ver1.00",
   "text": "「正式採用するか、通年商品にするかは……まあ、その反応次第だろう」",
   "voice": "rkc522_010"
  },
  {
   "file": "522・サブ－芦花（その後）ver1.00",
   "text": "「……まあ、悪くはない」",
   "voice": "rkc522_011"
  },
  {
   "file": "522・サブ－芦花（その後）ver1.00",
   "text": "「リンゴ……」",
   "voice": "rkc522_012"
  },
  {
   "file": "522・サブ－芦花（その後）ver1.00",
   "text": "「リンゴとか……いいかもな」",
   "voice": "rkc522_013"
  },
  {
   "file": "522・サブ－芦花（その後）ver1.00",
   "text": "「桃みたいな甘いやつとのバランスもいいが、リンゴで爽やかにした方が夏場はスッキリするかもしれない」",
   "voice": "rkc522_014"
  },
  {
   "file": "522・サブ－芦花（その後）ver1.00",
   "text": "「ここまでやったんだ。このグラニテに関しては、最後までお前がやってみろ」",
   "voice": "rkc522_015"
  }
 ]
}