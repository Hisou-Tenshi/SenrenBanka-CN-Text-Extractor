{
 "character": "外国人女性Ｂ",
 "count": 9,
 "lines": [
  {
   "file": "305・ムラサメちゃんルート０５ver1.2",
   "text": "「貴方、地元の学生さんですね？　その制服素敵ですよ」",
   "voice": "gjb305_001"
  },
  {
   "file": "305・ムラサメちゃんルート０５ver1.2",
   "text": "「こんにちは。穂織は三度目ですが、学生さんと話すのは初めてです」",
   "voice": "gjb305_002"
  },
  {
   "file": "305・ムラサメちゃんルート０５ver1.2",
   "text": "「独特の文化が素敵ですね」",
   "voice": "gjb305_003"
  },
  {
   "file": "305・ムラサメちゃんルート０５ver1.2",
   "text": "「あと、巫女姫の舞がとても綺麗です」",
   "voice": "gjb305_004"
  },
  {
   "file": "305・ムラサメちゃんルート０５ver1.2",
   "text": "「あの凜とした美しさは、女性から見ても素敵ですねー」",
   "voice": "gjb305_005"
  },
  {
   "file": "305・ムラサメちゃんルート０５ver1.2",
   "text": "「リサーチ、頑張ってください」",
   "voice": "gjb305_006"
  },
  {
   "file": "315・ムラサメちゃんルート１５ver1.3",
   "text": "「ファンタックステックです！」",
   "voice": "gjb315_001"
  },
  {
   "file": "315・ムラサメちゃんルート１５ver1.3",
   "text": "「ＨＥＹ！　カメラ目線ください！」",
   "voice": "gjb315_002"
  },
  {
   "file": "502・サブ－アルバイトver1.00",
   "text": "「タイショー、やってますかー？」",
   "voice": "gjb502_001"
  }
 ]
}