{
 "character": "茉子の母",
 "count": 45,
 "lines": [
  {
   "file": "202・茉子－実家ver1.01",
   "text": "「あら？　どうしたの、こんな時間に」",
   "voice": "mkh202_001"
  },
  {
   "file": "202・茉子－実家ver1.01",
   "text": "「風邪？　それともアナタ……巫女姫様に何か失礼なことでもしたの？」",
   "voice": "mkh202_002"
  },
  {
   "file": "202・茉子－実家ver1.01",
   "text": "「はーい」",
   "voice": "mkh202_003"
  },
  {
   "file": "202・茉子－実家ver1.01",
   "text": "「お待たせしました。どちら様でしょうか？」",
   "voice": "mkh202_004"
  },
  {
   "file": "202・茉子－実家ver1.01",
   "text": "「茉子……ですか？　もしかして、お友達……ですか？」",
   "voice": "mkh202_005"
  },
  {
   "file": "202・茉子－実家ver1.01",
   "text": "「あ、いえ、そもそも有地さんってもしかして、叢雨丸の……？」",
   "voice": "mkh202_006"
  },
  {
   "file": "202・茉子－実家ver1.01",
   "text": "「まあ！　まあまあ！　わざわざこんなところに足をお運びいただいて、ありがとうございます」",
   "voice": "mkh202_007"
  },
  {
   "file": "202・茉子－実家ver1.01",
   "text": "「あの子は、今はちょっと取り込み中でして」",
   "voice": "mkh202_008"
  },
  {
   "file": "202・茉子－実家ver1.01",
   "text": "「ですが、すぐに済みますから。是非上がって待っていて下さい」",
   "voice": "mkh202_009"
  },
  {
   "file": "202・茉子－実家ver1.01",
   "text": "「そう仰らずに。ここまで来てもらっておいて、何のお構いもできなかったら怒られてしまいます」",
   "voice": "mkh202_010"
  },
  {
   "file": "202・茉子－実家ver1.01",
   "text": "「よろしければ、部屋でお待ち下さい」",
   "voice": "mkh202_011"
  },
  {
   "file": "202・茉子－実家ver1.01",
   "text": "「それとも……何か火急の用件がおありですか？」",
   "voice": "mkh202_012"
  },
  {
   "file": "202・茉子－実家ver1.01",
   "text": "「でしたら是非」",
   "voice": "mkh202_013"
  },
  {
   "file": "202・茉子－実家ver1.01",
   "text": "「はい、ありがとうございます」",
   "voice": "mkh202_014"
  },
  {
   "file": "202・茉子－実家ver1.01",
   "text": "「こちらでお待ちください。茉子もすぐに参りますので」",
   "voice": "mkh202_015"
  },
  {
   "file": "202・茉子－実家ver1.01",
   "text": "「では、失礼致します」",
   "voice": "mkh202_016"
  },
  {
   "file": "202・茉子－実家ver1.01",
   "text": "「失礼致します」",
   "voice": "mkh202_017"
  },
  {
   "file": "202・茉子－実家ver1.01",
   "text": "「お茶をお持ちしました。さあ、どうぞ」",
   "voice": "mkh202_018"
  },
  {
   "file": "202・茉子－実家ver1.01",
   "text": "「わかりました。それでは、もし何かありましたら、いつでもお呼び下さい」",
   "voice": "mkh202_019"
  },
  {
   "file": "202・茉子－実家ver1.01",
   "text": "「どうぞ、ごゆっくり」",
   "voice": "mkh202_020"
  },
  {
   "file": "202・茉子－実家ver1.01",
   "text": "「失礼致します」",
   "voice": "mkh202_021"
  },
  {
   "file": "202・茉子－実家ver1.01",
   "text": "「申し訳ありません、お茶請けを忘れておりました」",
   "voice": "mkh202_022"
  },
  {
   "file": "202・茉子－実家ver1.01",
   "text": "「そんなこと仰らず、ゆっくりしていって下さい」",
   "voice": "mkh202_023"
  },
  {
   "file": "202・茉子－実家ver1.01",
   "text": "「はい、あーん」",
   "voice": "mkh202_024"
  },
  {
   "file": "202・茉子－実家ver1.01",
   "text": "「甘いものが苦手でしたら、すぐに塩気のあるお茶請けも用意致しますが？」",
   "voice": "mkh202_025"
  },
  {
   "file": "202・茉子－実家ver1.01",
   "text": "「申し訳ありません。茉子の友人が来るなんて初めてのことですから、つい」",
   "voice": "mkh202_026"
  },
  {
   "file": "202・茉子－実家ver1.01",
   "text": "「もし何かありましたら、いつでもお呼び下さい」",
   "voice": "mkh202_027"
  },
  {
   "file": "202・茉子－実家ver1.01",
   "text": "「なにかお困りごとは……？」",
   "voice": "mkh202_028"
  },
  {
   "file": "202・茉子－実家ver1.01",
   "text": "「そうですか。ごゆっくり」",
   "voice": "mkh202_029"
  },
  {
   "file": "202・茉子－実家ver1.01",
   "text": "「あのアイスなら箱を捨てたから、トレーの上に移動させたはずだけどー」",
   "voice": "mkh202_030"
  },
  {
   "file": "202・茉子－実家ver1.01",
   "text": "「それから茉子。さっきお客様がお見えになったから」",
   "voice": "mkh202_031"
  },
  {
   "file": "202・茉子－実家ver1.01",
   "text": "「ウチじゃなくてアナタによ」",
   "voice": "mkh202_032"
  },
  {
   "file": "202・茉子－実家ver1.01",
   "text": "「部屋にお通ししたからね。ちゃんとなさい」",
   "voice": "mkh202_033"
  },
  {
   "file": "202・茉子－実家ver1.01",
   "text": "「どうしたの急に」",
   "voice": "mkh202_034"
  },
  {
   "file": "202・茉子－実家ver1.01",
   "text": "「幻覚が見えたらもはやメガネではどうにもならないと思うけど？　お薬の出番じゃない？」",
   "voice": "mkh202_035"
  },
  {
   "file": "202・茉子－実家ver1.01",
   "text": "「いくら忍びの家系でも、ウチにそんな怪しい薬はありませんっ」",
   "voice": "mkh202_036"
  },
  {
   "file": "202・茉子－実家ver1.01",
   "text": "「というか、またそんな格好のままで。ちゃんと服を着なさい。有地さんに失礼でしょう」",
   "voice": "mkh202_037"
  },
  {
   "file": "202・茉子－実家ver1.01",
   "text": "「何をわけのわからないことを。幻覚じゃない。本物の有地将臣さんです」",
   "voice": "mkh202_038"
  },
  {
   "file": "202・茉子－実家ver1.01",
   "text": "「ほら、早くちゃんと服を着て、おもてなしをしなさい」",
   "voice": "mkh202_039"
  },
  {
   "file": "202・茉子－実家ver1.01",
   "text": "「申し訳ありません。茉子の友人が来るなんて初めてのことですから、つい」",
   "voice": "mkh202_026_ref"
  },
  {
   "file": "202・茉子－実家ver1.01",
   "text": "「もうお帰りですか？」",
   "voice": "mkh202_040"
  },
  {
   "file": "202・茉子－実家ver1.01",
   "text": "「何言ってるの。有地さんには茉子も日頃からお世話になってるんだから」",
   "voice": "mkh202_041"
  },
  {
   "file": "202・茉子－実家ver1.01",
   "text": "「親として、挨拶ぐらいはしておかないと失礼になるでしょう」",
   "voice": "mkh202_042"
  },
  {
   "file": "202・茉子－実家ver1.01",
   "text": "「それに若い男の子と話す機会なんて滅多にないんだもの」",
   "voice": "mkh202_043"
  },
  {
   "file": "202・茉子－実家ver1.01",
   "text": "「有地さん、こんな子ですが、今後ともなにとぞよろしくお願い致します」",
   "voice": "mkh202_044"
  }
 ]
}