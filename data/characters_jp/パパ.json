{
 "character": "パパ",
 "count": 11,
 "lines": [
  {
   "file": "414レナ・イザナウ",
   "text": "「お祖父ちゃんだけじゃないぞ、レナ」",
   "voice": "pap414_001"
  },
  {
   "file": "414レナ・イザナウ",
   "text": "「あははは、忘れたのか？　レナ」",
   "voice": "pap414_002"
  },
  {
   "file": "414レナ・イザナウ",
   "text": "「けど早く食べないと、お料理が冷めてしまうぞ」",
   "voice": "pap414_003"
  },
  {
   "file": "414レナ・イザナウ",
   "text": "「当たり前じゃないか、レナ」",
   "voice": "pap414_004"
  },
  {
   "file": "414レナ・イザナウ",
   "text": "「愛してるよ、レナ」",
   "voice": "pap414_005"
  },
  {
   "file": "414レナ・イザナウ",
   "text": "「本当にそうかい？」",
   "voice": "pap414_006"
  },
  {
   "file": "414レナ・イザナウ",
   "text": "「本来、家族は１つであるべきなんだから」",
   "voice": "pap414_007"
  },
  {
   "file": "414レナ・イザナウ",
   "text": "「ほら、レナも早く食べなさい」",
   "voice": "pap414_009"
  },
  {
   "file": "414レナ・イザナウ",
   "text": "「いらないなら、お父さんが全部食べてしまうぞ」",
   "voice": "pap414_010"
  },
  {
   "file": "414レナ・イザナウ",
   "text": "「だったら素直になればいいじゃないか」",
   "voice": "pap414_011"
  },
  {
   "file": "414レナ・イザナウ",
   "text": "「いい加減にしなさいっ、レナ！」",
   "voice": "pap414_012"
  }
 ]
}