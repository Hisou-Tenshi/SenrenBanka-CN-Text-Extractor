{
 "character": "男",
 "count": 20,
 "lines": [
  {
   "file": "102・芳乃－告白ver1.03",
   "text": "「――あのう、申し訳ありません」",
   "voice": "otk102_001"
  },
  {
   "file": "102・芳乃－告白ver1.03",
   "text": "「あ、いえ、アナタではなくて……そちらの御嬢様に」",
   "voice": "otk102_002"
  },
  {
   "file": "102・芳乃－告白ver1.03",
   "text": "「はい。もし人違いでしたら申し訳ありませんが……朝武芳乃様でいらっしゃいますよね？　巫女姫の」",
   "voice": "otk102_003"
  },
  {
   "file": "102・芳乃－告白ver1.03",
   "text": "「いえいえ初対面ですからお気になさらずに。ああ！　自己紹介もせず、誠に申し訳ありません」",
   "voice": "otk102_004"
  },
  {
   "file": "102・芳乃－告白ver1.03",
   "text": "「わたくし、こういうものでして」",
   "voice": "otk102_005"
  },
  {
   "file": "102・芳乃－告白ver1.03",
   "text": "「むしろ、突然声をかけたりして失礼致しました」",
   "voice": "otk102_006"
  },
  {
   "file": "102・芳乃－告白ver1.03",
   "text": "「しかし……こんな道端ではなんですから、どこかお店に入りませんか？」",
   "voice": "otk102_007"
  },
  {
   "file": "102・芳乃－告白ver1.03",
   "text": "「そうですか……」",
   "voice": "otk102_008"
  },
  {
   "file": "102・芳乃－告白ver1.03",
   "text": "「いや、そうですね。巫女姫様ともなれば、ご予定もありますよね」",
   "voice": "otk102_009"
  },
  {
   "file": "102・芳乃－告白ver1.03",
   "text": "「ああいや、もう少しだけお待ち下さい。もう店でとは言いません」",
   "voice": "otk102_010"
  },
  {
   "file": "102・芳乃－告白ver1.03",
   "text": "「お渡ししたい物がありまして。すぐにすみますから。それをお受け取りいただければ、すぐにでも退散いたしますので」",
   "voice": "otk102_011"
  },
  {
   "file": "102・芳乃－告白ver1.03",
   "text": "「こちらをご覧いただけますか？　何卒、何卒よろしくお願い致します」",
   "voice": "otk102_012"
  },
  {
   "file": "102・芳乃－告白ver1.03",
   "text": "「まあまあ、そう今すぐ決めなくても。やはり一度会ってみないことには解らないことも多いと思いますから」",
   "voice": "otk102_013"
  },
  {
   "file": "102・芳乃－告白ver1.03",
   "text": "「どうかそう仰らずに。とてもいい人なんです。見た目や家柄はもちろん、性格にも問題ありません」",
   "voice": "otk102_014"
  },
  {
   "file": "102・芳乃－告白ver1.03",
   "text": "「細かいプロフィールは中に記載していますが、私が保証致しますよ」",
   "voice": "otk102_015"
  },
  {
   "file": "102・芳乃－告白ver1.03",
   "text": "「………」",
   "voice": "otk102_016"
  },
  {
   "file": "102・芳乃－告白ver1.03",
   "text": "「わかりました。巫女姫様がそうおっしゃるのでしたら」",
   "voice": "otk102_017"
  },
  {
   "file": "102・芳乃－告白ver1.03",
   "text": "「連絡先は中に記してありますので、何卒よろしくお願い致します」",
   "voice": "otk102_018"
  },
  {
   "file": "102・芳乃－告白ver1.03",
   "text": "「本当によろしくお願いします！　連絡をお待ちしておりますので！」",
   "voice": "otk102_019"
  },
  {
   "file": "102・芳乃－告白ver1.03",
   "text": "「お待ちしておりますのでーーー！！」",
   "voice": "otk102_020"
  }
 ]
}