{
 "character": "祖父",
 "count": 9,
 "lines": [
  {
   "file": "414レナ・イザナウ",
   "text": "「なにを言っているんだい、レナ？」",
   "voice": "sof414_001"
  },
  {
   "file": "414レナ・イザナウ",
   "text": "「お前がこの旅館がいいと自慢するから、どうしても一度来てみたくなったんだ」",
   "voice": "sof414_002"
  },
  {
   "file": "414レナ・イザナウ",
   "text": "「前から、そう思ってたんだろう？」",
   "voice": "sof414_003"
  },
  {
   "file": "414レナ・イザナウ",
   "text": "「本当に寂しくないのかい、レナ？」",
   "voice": "sof414_004"
  },
  {
   "file": "414レナ・イザナウ",
   "text": "「なに、レナは優しい子だから、我慢することに慣れてしまっただけじゃないかと心配になったんだよ」",
   "voice": "sof414_005"
  },
  {
   "file": "414レナ・イザナウ",
   "text": "「でも、せっかく家族が揃ったんだ。ちょっとくらい食べたっていいじゃないか」",
   "voice": "sof414_007"
  },
  {
   "file": "414レナ・イザナウ",
   "text": "「ほら、見せてご覧、レナ？　お前の好きな料理を選んでいいんだから」",
   "voice": "sof414_008"
  },
  {
   "file": "414レナ・イザナウ",
   "text": "「トロルだと？　そんなもの、どうだっていいじゃないか！」",
   "voice": "sof414_009"
  },
  {
   "file": "414レナ・イザナウ",
   "text": "「レェェェェナァァァァァッ！！？」",
   "voice": "sof414_010"
  }
 ]
}