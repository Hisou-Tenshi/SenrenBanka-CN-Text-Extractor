{
 "character": "成美",
 "count": 75,
 "lines": [
  {
   "file": "007・レナ転入ver1.03",
   "text": "「我是柳生成美」",
   "voice": "nrm007_004"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「哎？蕾娜听说过巫女大人的事吗？」",
   "voice": "nrm007_005"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「原来是这样」",
   "voice": "nrm007_006"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「上衣不穿上吗？」",
   "voice": "nrm007_007"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「呃，虽然听着让人有点不爽，但你这个尺寸确实有点惊人……也没办法了」",
   "voice": "nrm007_008"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「注意发音注意发音」",
   "voice": "nrm007_009"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「不过失礼的事当然还是不能做的」",
   "voice": "nrm007_010"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「在旅馆工作的话，要求确实会比较严格」",
   "voice": "nrm007_011"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「是榻榻米和温泉啦」",
   "voice": "nrm007_012"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「哎，是嘛。蕾娜能吃芥末吗？」",
   "voice": "nrm007_013"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「如果吃不了的话直说就好啦」",
   "voice": "nrm007_014"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「肯定在打蕾娜的主意。你要小心哦，鞍马同学就是个渣男」",
   "voice": "nrm007_015"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「哎？呃……怎么解释比较好呢……」",
   "voice": "nrm007_016"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「你要小心，不要被鞍马同学骗了」",
   "voice": "nrm007_017"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「啊，鞍马同学想对蕾娜下手了！」",
   "voice": "nrm007_018"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「好！搞定了！」",
   "voice": "nrm007_019"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「旅馆员工的休息时间，一定程度上也取决于住客嘛」",
   "voice": "nrm007_020"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「下次有机会的话再一起出去玩吧」",
   "voice": "nrm007_021"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「明天见」",
   "voice": "nrm007_022"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「啊，巫女大人，再见」",
   "voice": "nrm007_023"
  },
  {
   "file": "009・謎の欠片ver1.03",
   "text": "「我说，如果可以的话，我们也一起来交换吧？」",
   "voice": "nrm009_001"
  },
  {
   "file": "009・謎の欠片ver1.03",
   "text": "「我提供这块汉堡牛肉饼」",
   "voice": "nrm009_002"
  },
  {
   "file": "009・謎の欠片ver1.03",
   "text": "「你别提这样的要求啦」",
   "voice": "nrm009_003"
  },
  {
   "file": "101・芳乃－弁当ver1.02",
   "text": "「怎么愁眉苦脸的？」",
   "voice": "nrm101_001"
  },
  {
   "file": "104・芳乃－記者会見ver1.05",
   "text": "「我是二年级的柳生成美。恭喜你们结婚」",
   "voice": "nrm104_001"
  },
  {
   "file": "104・芳乃－記者会見ver1.05",
   "text": "「是谁求的婚呢？能说说是怎么求的婚吗？」",
   "voice": "nrm104_002"
  },
  {
   "file": "104・芳乃－記者会見ver1.05",
   "text": "「我们想知道的正是这一点！」",
   "voice": "nrm104_003"
  },
  {
   "file": "104・芳乃－記者会見ver1.05",
   "text": "「还没接过吻啊……？」",
   "voice": "nrm104_005"
  },
  {
   "file": "107・芳乃－獣耳ver1.02",
   "text": "「怎么了？吵架？」",
   "voice": "nrm107_001"
  },
  {
   "file": "107・芳乃－獣耳ver1.02",
   "text": "「但是……他们是不是有点怪怪的？」",
   "voice": "nrm107_002"
  },
  {
   "file": "107・芳乃－獣耳ver1.02",
   "text": "「……既然常陆同学这么说，那应该就没错了吧」",
   "voice": "nrm107_003"
  },
  {
   "file": "107・芳乃－獣耳ver1.02",
   "text": "「巫女大人真的没事吗？」",
   "voice": "nrm107_004"
  },
  {
   "file": "107・芳乃－獣耳ver1.02",
   "text": "「那就好。刚刚的有地同学看起来有点可怕……」",
   "voice": "nrm107_005"
  },
  {
   "file": "107・芳乃－獣耳ver1.02",
   "text": "「嗯……这次或许确实不需要担心……」",
   "voice": "nrm107_006"
  },
  {
   "file": "107・芳乃－獣耳ver1.02",
   "text": "「巫女大人，如果遇到什么困难，可以随时找我们谈」",
   "voice": "nrm107_007"
  },
  {
   "file": "107・芳乃－獣耳ver1.02",
   "text": "「好的」",
   "voice": "nrm107_008"
  },
  {
   "file": "107・芳乃－獣耳ver1.02",
   "text": "「什么我们啊……你别随便把我拉进去好吗？」",
   "voice": "nrm107_009"
  },
  {
   "file": "107・芳乃－獣耳ver1.02",
   "text": "「呃……这、这也是。或许没法给什么有用的建议……」",
   "voice": "nrm107_010"
  },
  {
   "file": "107・芳乃－獣耳ver1.02",
   "text": "「我们能做到的……也就只有陪她聊聊天，散散心了」",
   "voice": "nrm107_011"
  },
  {
   "file": "107・芳乃－獣耳ver1.02",
   "text": "「对不起，巫女大人。我们完全派不上用场」",
   "voice": "nrm107_012"
  },
  {
   "file": "107・芳乃－獣耳ver1.02",
   "text": "「是、是吗？你这么说我很高兴」",
   "voice": "nrm107_013"
  },
  {
   "file": "107・芳乃－獣耳ver1.02",
   "text": "「没想到巫女大人会对我们说这样的话……有点惊讶」",
   "voice": "nrm107_014"
  },
  {
   "file": "107・芳乃－獣耳ver1.02",
   "text": "「烦恼也好牢骚也好，你随时都可以找我谈」",
   "voice": "nrm107_015"
  },
  {
   "file": "107・芳乃－獣耳ver1.02",
   "text": "「也是，这样也好。如果巫女大人不介意……的话」",
   "voice": "nrm107_016"
  },
  {
   "file": "107・芳乃－獣耳ver1.02",
   "text": "「哎？是吗」",
   "voice": "nrm107_017"
  },
  {
   "file": "107・芳乃－獣耳ver1.02",
   "text": "「女子会……可以这么说吗？我印象中，女子会都是工作后的大人才参加的」",
   "voice": "nrm107_018"
  },
  {
   "file": "107・芳乃－獣耳ver1.02",
   "text": "「这也是。那下次我们一起举办女子会吧」",
   "voice": "nrm107_019"
  },
  {
   "file": "110・芳乃－初体験ver1.01",
   "text": "「难道有地同学逼迫了你？」",
   "voice": "nrm110_001"
  },
  {
   "file": "110・芳乃－初体験ver1.01",
   "text": "「那就好……」",
   "voice": "nrm110_002"
  },
  {
   "file": "110・芳乃－初体験ver1.01",
   "text": "「这、这就不知道了。莫非是……榻榻米的神灵？」",
   "voice": "nrm110_003"
  },
  {
   "file": "110・芳乃－初体験ver1.01",
   "text": "「之前我也说过，不管是抱怨还是什么，都可以跟我说」",
   "voice": "nrm110_004"
  },
  {
   "file": "202・茉子－実家ver1.01",
   "text": "「巫女大人今天带的便当看起来也很好吃啊」",
   "voice": "nrm202_001"
  },
  {
   "file": "204・茉子－気持ちver1.00",
   "text": "「说起来，巫女大人，您好像又拒绝了相亲啊」",
   "voice": "nrm204_001"
  },
  {
   "file": "204・茉子－気持ちver1.00",
   "text": "「这类消息在左邻右舍间其实传得可快了哦」",
   "voice": "nrm204_002"
  },
  {
   "file": "204・茉子－気持ちver1.00",
   "text": "「巫女大人不喜欢相亲吗？您是不是喜欢更平常点的邂逅？」",
   "voice": "nrm204_003"
  },
  {
   "file": "204・茉子－気持ちver1.00",
   "text": "「是这样啊……不过也对，毕竟您还是个学生」",
   "voice": "nrm204_004"
  },
  {
   "file": "204・茉子－気持ちver1.00",
   "text": "「她只是随便说说而已，巫女大人别太当真了」",
   "voice": "nrm204_005"
  },
  {
   "file": "204・茉子－気持ちver1.00",
   "text": "「她虽然这么说，但其实她并没有跟男生交往的经验哦」",
   "voice": "nrm204_006"
  },
  {
   "file": "204・茉子－気持ちver1.00",
   "text": "「我都跟你说几遍了……舍弃处女的年龄跟女子力的高低没关系」",
   "voice": "nrm204_007"
  },
  {
   "file": "204・茉子－気持ちver1.00",
   "text": "「你真要问的话，我也说不出个所以然啦」",
   "voice": "nrm204_008"
  },
  {
   "file": "204・茉子－気持ちver1.00",
   "text": "「大概就是……身为女性的魅力吧？」",
   "voice": "nrm204_009"
  },
  {
   "file": "204・茉子－気持ちver1.00",
   "text": "「比如对流行的事物比较敏感，或者擅长化妆……还有擅长料理等一系列家务事，这些都是女子力高的表现」",
   "voice": "nrm204_010"
  },
  {
   "file": "204・茉子－気持ちver1.00",
   "text": "「但是会做饭，房间应该也整理得漂漂亮亮的，这样看来茉子的女子力确实挺高的……」",
   "voice": "nrm204_011"
  },
  {
   "file": "204・茉子－気持ちver1.00",
   "text": "「话说回来……那对胸部还是那么惊人啊」",
   "voice": "nrm204_012"
  },
  {
   "file": "204・茉子－気持ちver1.00",
   "text": "「啊，真的耶。是什么时候跑进来的啊？」",
   "voice": "nrm204_013"
  },
  {
   "file": "204・茉子－気持ちver1.00",
   "text": "「乖乖乖」",
   "voice": "nrm204_014"
  },
  {
   "file": "204・茉子－気持ちver1.00",
   "text": "「可爱是挺可爱的……不过这孩子是什么时候跑进来的啊？」",
   "voice": "nrm204_015"
  },
  {
   "file": "204・茉子－気持ちver1.00",
   "text": "「巫女大人和常陆同学呢——咦？常陆同学呢？」",
   "voice": "nrm204_016"
  },
  {
   "file": "204・茉子－気持ちver1.00",
   "text": "「常陆同学好像不见了」",
   "voice": "nrm204_017"
  },
  {
   "file": "204・茉子－気持ちver1.00",
   "text": "「有没有什么中午的剩饭？」",
   "voice": "nrm204_019"
  },
  {
   "file": "204・茉子－気持ちver1.00",
   "text": "「哎，是这样吗？」",
   "voice": "nrm204_020"
  },
  {
   "file": "204・茉子－気持ちver1.00",
   "text": "「你好像很了解啊。以前有养过吗？」",
   "voice": "nrm204_021"
  },
  {
   "file": "204・茉子－気持ちver1.00",
   "text": "「这我知道啦……为什么巫女大人要这么拼命解释啊？」",
   "voice": "nrm204_022"
  },
  {
   "file": "206・茉子－オナニーver1.00",
   "text": "「到底怎么回事啊，巫女大人？」",
   "voice": "nrm206_001"
  },
  {
   "file": "301・ムラサメちゃんルート０１ver1.3",
   "text": "「啊，吃午饭了」",
   "voice": "nrm301_001"
  }
 ]
}