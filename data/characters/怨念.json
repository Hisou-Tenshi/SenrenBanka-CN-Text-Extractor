{
 "character": "怨念",
 "count": 13,
 "lines": [
  {
   "file": "108・芳乃－解呪ver1.01",
   "text": "『好恨啊……好恨啊……好恨啊，好恨啊，好恨啊，好恨啊，好恨啊……』",
   "voice": "onn108_001"
  },
  {
   "file": "108・芳乃－解呪ver1.01",
   "text": "『不可饶恕……不可饶恕……不可饶恕……』",
   "voice": "onn108_002"
  },
  {
   "file": "108・芳乃－解呪ver1.01",
   "text": "『我绝不会原谅那家伙，不会原谅那家伙的家人……不会原谅那家伙的子孙！』",
   "voice": "onn108_003"
  },
  {
   "file": "108・芳乃－解呪ver1.01",
   "text": "『……不可饶恕……我要诅咒你的子子孙孙』",
   "voice": "onn108_004"
  },
  {
   "file": "108・芳乃－解呪ver1.01",
   "text": "『好恨啊，好恨那家伙……好恨那家伙繁荣昌盛的生活……』",
   "voice": "onn108_005"
  },
  {
   "file": "108・芳乃－解呪ver1.01",
   "text": "『好恨啊……好恨啊……好恨啊……』",
   "voice": "onn108_006"
  },
  {
   "file": "108・芳乃－解呪ver1.01",
   "text": "「我不会轻易消失，我要在这里做个了结，我要夺走那家伙留下的一切」",
   "voice": "onn108_007"
  },
  {
   "file": "108・芳乃－解呪ver1.01",
   "text": "「只要杀掉你就行了，我就可以终结他留下的一切」",
   "voice": "onn108_008"
  },
  {
   "file": "108・芳乃－解呪ver1.01",
   "text": "「在消失之前……我一定……」",
   "voice": "onn108_009"
  },
  {
   "file": "108・芳乃－解呪ver1.01",
   "text": "「要带你上路，要做个了结」",
   "voice": "onn108_010"
  },
  {
   "file": "108・芳乃－解呪ver1.01",
   "text": "「我至少也得拉着你上路」",
   "voice": "onn108_011"
  },
  {
   "file": "108・芳乃－解呪ver1.01",
   "text": "「我要做个了结。不可饶恕，我绝不原谅……」",
   "voice": "onn108_012"
  },
  {
   "file": "108・芳乃－解呪ver1.01",
   "text": "「……」",
   "voice": "onn108_013"
  }
 ]
}