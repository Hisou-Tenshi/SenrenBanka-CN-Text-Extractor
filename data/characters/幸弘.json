 "lines": [
  {
   "file": "316・ムラサメちゃんルート１６ver1.2",
   "text": "「哎呀，初次见面。我是将臣的父亲，有地幸弘」",
   "voice": "ykh316_001"
  },
  {
   "file": "316・ムラサメちゃんルート１６ver1.2",
   "text": "「没事没事，不用那么拘谨」",
   "voice": "ykh316_002"
  },
  {
   "file": "316・ムラサメちゃんルート１６ver1.2",
   "text": "「放轻松一点」",
   "voice": "ykh316_003"
  },
  {
   "file": "316・ムラサメちゃんルート１６ver1.2",
   "text": "「丛雨小姐，你愿意嫁给我家这个蠢儿子吗？」",
   "voice": "ykh316_004"
  },
  {
   "file": "316・ムラサメちゃんルート１６ver1.2",
   "text": "「那就叫我爸爸吧」",
   "voice": "ykh316_005"
  }
 ]
}