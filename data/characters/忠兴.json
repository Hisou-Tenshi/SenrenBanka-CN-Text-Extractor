{
 "character": "忠兴",
 "count": 50,
 "lines": [
  {
   "file": "007・レナ転入ver1.03",
   "text": "「我叫田宫忠兴」",
   "voice": "tdo007_005"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「请多指教」",
   "voice": "tdo007_006"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「他之前在和班级里的女生交往。可是过了没多久就分手了」",
   "voice": "tdo007_007"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「是同一个班级里的另一个女生。而且是分手的第二天就好上了」",
   "voice": "tdo007_008"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「正常人会做这种事吗？那两个人现在还在这个班级里一起学习啊」",
   "voice": "tdo007_009"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「可是没过多久，他又和新女友分手了」",
   "voice": "tdo007_010"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「然后鞍马的坏话就被一传再传」",
   "voice": "tdo007_011"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「应该是在镇上都出名了吧」",
   "voice": "tdo007_012"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「啊，说到巫女大人……有件事我之前就想问了……」",
   "voice": "tdo007_013"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「有地，你好像和巫女大人挺亲近啊」",
   "voice": "tdo007_014"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「巫女大人家里可是名门望族」",
   "voice": "tdo007_015"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「所以啊，听我妈说，到了她这个年纪，正常来说应该已经订婚了」",
   "voice": "tdo007_016"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「我本以为你说不定就是她未婚夫……但是现在仔细想想……」",
   "voice": "tdo007_017"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「有地不可能是未婚夫啦。有地怎么配得上她呢」",
   "voice": "tdo007_019"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「没错没错」",
   "voice": "tdo007_021"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「话说回来，大城市是不是跟这边很不一样？」",
   "voice": "tdo007_022"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「就是有那种……裙子短得连内裤都快要露出来的女生！」",
   "voice": "tdo007_023"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「什么，原来是这样……」",
   "voice": "tdo007_024"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「不过有很多光大腿可以看还是很棒的。这边的话基本都是遮起来的，尤其是穿便服的时候」",
   "voice": "tdo007_025"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「哎哟，打铃了，抱歉先失陪了」",
   "voice": "tdo007_026"
  },
  {
   "file": "104・芳乃－記者会見ver1.05",
   "text": "「不过您不会再去相亲了吧？」",
   "voice": "tdo104_001"
  },
  {
   "file": "104・芳乃－記者会見ver1.05",
   "text": "「这也就是说，有地将臣同学是最有望的新郎候选人，对吧？」",
   "voice": "tdo104_002"
  },
  {
   "file": "104・芳乃－記者会見ver1.05",
   "text": "「具体发展到什么地步了？」",
   "voice": "tdo104_003"
  },
  {
   "file": "104・芳乃－記者会見ver1.05",
   "text": "「啊，不，我不是这个意思。不，当然这些我们也很感兴趣，但我们更想知道的是……」",
   "voice": "tdo104_004"
  },
  {
   "file": "104・芳乃－記者会見ver1.05",
   "text": "「这莫非……已经发展到不能告诉别人的那一步了――！？」",
   "voice": "tdo104_005"
  },
  {
   "file": "104・芳乃－記者会見ver1.05",
   "text": "「别让女生蒙羞啊！难道你是处男吗」",
   "voice": "tdo104_006"
  },
  {
   "file": "104・芳乃－記者会見ver1.05",
   "text": "「啊，那最后问一句！」",
   "voice": "tdo104_007"
  },
  {
   "file": "104・芳乃－記者会見ver1.05",
   "text": "「离婚招待会准备什么时候举行呢？」",
   "voice": "tdo104_008"
  },
  {
   "file": "202・茉子－実家ver1.01",
   "text": "「哇。你这人也太恶心了吧。真鄙视你……」",
   "voice": "tdo202_001"
  },
  {
   "file": "202・茉子－実家ver1.01",
   "text": "「真的吗！？在哪里啊！？从哪个角度看！？」",
   "voice": "tdo202_002"
  },
  {
   "file": "202・茉子－実家ver1.01",
   "text": "「啊，可恶，你算计我！？」",
   "voice": "tdo202_003"
  },
  {
   "file": "202・茉子－実家ver1.01",
   "text": "「明明手脚不老实，在某些方面却装得特别老练」",
   "voice": "tdo202_004"
  },
  {
   "file": "202・茉子－実家ver1.01",
   "text": "「怎么了？这么突然？」",
   "voice": "tdo202_005"
  },
  {
   "file": "202・茉子－実家ver1.01",
   "text": "「哎呀哎呀，难道说你喜欢上她了？」",
   "voice": "tdo202_006"
  },
  {
   "file": "202・茉子－実家ver1.01",
   "text": "「说得没错」",
   "voice": "tdo202_007"
  },
  {
   "file": "202・茉子－実家ver1.01",
   "text": "「原来……你是这么恶心的人啊……」",
   "voice": "tdo202_008"
  },
  {
   "file": "202・茉子－実家ver1.01",
   "text": "「可是常陆同学她从早到晚，不管是工作日还是休息日，一直都在照顾巫女大人吧？」",
   "voice": "tdo202_009"
  },
  {
   "file": "202・茉子－実家ver1.01",
   "text": "「你想啊，假设你和她表白了，然后她答应了，可你觉得她会有时间和你约会吗？」",
   "voice": "tdo202_010"
  },
  {
   "file": "202・茉子－実家ver1.01",
   "text": "「是不是因为常陆家的祖先是重臣，所以延续了古时候的习俗？」",
   "voice": "tdo202_011"
  },
  {
   "file": "202・茉子－実家ver1.01",
   "text": "「想起来了，确实有过。我当时做的是关于古代筑城的研究」",
   "voice": "tdo202_012"
  },
  {
   "file": "202・茉子－実家ver1.01",
   "text": "「啊！？田宫家是我家吗！？古时候居然当过重臣啊……我第一次知道……」",
   "voice": "tdo202_013"
  },
  {
   "file": "202・茉子－実家ver1.01",
   "text": "「可是，常陆家是忍者世家吧？」",
   "voice": "tdo202_014"
  },
  {
   "file": "202・茉子－実家ver1.01",
   "text": "「之所以查不到资料，可能是因为他们家故意不想让人查出底细，但实际上他们也相当于重臣？」",
   "voice": "tdo202_015"
  },
  {
   "file": "208・茉子－いちゃラヴver1.00",
   "text": "「早啊」",
   "voice": "tdo208_001"
  },
  {
   "file": "208・茉子－いちゃラヴver1.00",
   "text": "「你那副意味深长的从容微笑……很让人恼火啊」",
   "voice": "tdo208_002"
  },
  {
   "file": "208・茉子－いちゃラヴver1.00",
   "text": "「总之先别笑了。否则没法聊下去」",
   "voice": "tdo208_003"
  },
  {
   "file": "208・茉子－いちゃラヴver1.00",
   "text": "「真好啊……我也想要像常陆同学一样可爱的女朋友……」",
   "voice": "tdo208_004"
  },
  {
   "file": "208・茉子－いちゃラヴver1.00",
   "text": "「是、是吗……果然干等着是不行的啊」",
   "voice": "tdo208_005"
  },
  {
   "file": "208・茉子－いちゃラヴver1.00",
   "text": "「虽然我们说这些可能没什么必要，但还是要祝福下你们。加油吧，好好交往」",
   "voice": "tdo208_006"
  },
  {
   "file": "208・茉子－いちゃラヴver1.00",
   "text": "「但是该不爽还是会不爽的，所以你们想亲热就到其他地方去。知道了吗？」",
   "voice": "tdo208_007"
  }
 ]
}