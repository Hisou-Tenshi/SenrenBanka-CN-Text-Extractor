{
 "character": "老伯",
 "count": 13,
 "lines": [
  {
   "file": "003・巫女の秘密ver1.11",
   "text": "「嗨，茉子！出来买菜吗？要不要来点包菜呀？」",
   "voice": "oyj003_001"
  },
  {
   "file": "003・巫女の秘密ver1.11",
   "text": "「再送你些橙子，尝尝吧」",
   "voice": "oyj003_002"
  },
  {
   "file": "003・巫女の秘密ver1.11",
   "text": "「嗯。今年春日祭，巫女大人的舞蹈也很美啊。代我告诉她我很期待明年的春日祭」",
   "voice": "oyj003_003"
  },
  {
   "file": "104・芳乃－記者会見ver1.05",
   "text": "「完全没错！哇哈哈哈哈！」",
   "voice": "oyj104_001"
  },
  {
   "file": "104・芳乃－記者会見ver1.05",
   "text": "「茉子，再来一瓶酒～」",
   "voice": "oyj104_002"
  },
  {
   "file": "104・芳乃－記者会見ver1.05",
   "text": "「来来来！总统驾到啦！哇哈哈哈哈！」",
   "voice": "oyj104_003"
  },
  {
   "file": "104・芳乃－記者会見ver1.05",
   "text": "「我比他好得多不是？让我来当候补不是更好？」",
   "voice": "oyj104_004"
  },
  {
   "file": "104・芳乃－記者会見ver1.05",
   "text": "「还有今后的事！婚礼准备定在啥时举行？」",
   "voice": "oyj104_005"
  },
  {
   "file": "104・芳乃－記者会見ver1.05",
   "text": "「不不，肯定是因为新郎官在紧张啦」",
   "voice": "oyj104_006"
  },
  {
   "file": "104・芳乃－記者会見ver1.05",
   "text": "「要消除紧张，喝果汁最合适了。来来，快拿杯子过来」",
   "voice": "oyj104_007"
  },
  {
   "file": "104・芳乃－記者会見ver1.05",
   "text": "「就是果汁啦，大米做的果汁」",
   "voice": "oyj104_008"
  },
  {
   "file": "104・芳乃－記者会見ver1.05",
   "text": "「来来！再来一杯」",
   "voice": "oyj104_009"
  },
  {
   "file": "106・芳乃－キスver1.01",
   "text": "「……」",
   "voice": "oyj106_001"
  }
 ]
}