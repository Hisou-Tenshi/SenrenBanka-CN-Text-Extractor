   "file": "001・アーサー王ver1.07",
   "text": "「先生您醒醒」",
   "voice": "uts001_001"
  },
  {
   "file": "001・アーサー王ver1.07",
   "text": "「马上就快到了，请问咱们在哪停车？」",
   "voice": "uts001_002"
  },
  {
   "file": "001・アーサー王ver1.07",
   "text": "「啊……抱歉。这一带我不是很熟来着」",
   "voice": "uts001_003"
  },
  {
   "file": "001・アーサー王ver1.07",
   "text": "「所以……可不可以不进里面？」",
   "voice": "uts001_004"
  },
  {
   "file": "001・アーサー王ver1.07",
   "text": "「真的很抱歉」",
   "voice": "uts001_005"
  },
  {
   "file": "001・アーサー王ver1.07",
   "text": "「感谢您的理解」",
   "voice": "uts001_006"
  },
