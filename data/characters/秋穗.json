{
 "character": "秋穗",
 "count": 45,
 "lines": [
  {
   "file": "108・芳乃－解呪ver1.01",
   "text": "「我……又在那孩子面前哭了……」",
   "voice": "akh108_001"
  },
  {
   "file": "108・芳乃－解呪ver1.01",
   "text": "「作为母亲，我折磨了孩子，让她难过……我真是太软弱了」",
   "voice": "akh108_002"
  },
  {
   "file": "108・芳乃－解呪ver1.01",
   "text": "「可那孩子跟我不一样，她很坚强，一定是因为她像你」",
   "voice": "akh108_003"
  },
  {
   "file": "108・芳乃－解呪ver1.01",
   "text": "「其实我想让她过上自由的生活」",
   "voice": "akh108_004"
  },
  {
   "file": "108・芳乃－解呪ver1.01",
   "text": "「因此我想为她创造条件，可现在却……」",
   "voice": "akh108_005"
  },
  {
   "file": "108・芳乃－解呪ver1.01",
   "text": "「你为什么要道歉？又不怪你……」",
   "voice": "akh108_006"
  },
  {
   "file": "108・芳乃－解呪ver1.01",
   "text": "「这也不是你的责任，别道歉了」",
   "voice": "akh108_007"
  },
  {
   "file": "108・芳乃－解呪ver1.01",
   "text": "「……我知道」",
   "voice": "akh108_008"
  },
  {
   "file": "108・芳乃－解呪ver1.01",
   "text": "「她肯定觉得现在这样不行，觉得要让自己变强。可是……」",
   "voice": "akh108_009"
  },
  {
   "file": "108・芳乃－解呪ver1.01",
   "text": "「留给我的时间已经不多了……」",
   "voice": "akh108_010"
  },
  {
   "file": "108・芳乃－解呪ver1.01",
   "text": "「我自己清楚的」",
   "voice": "akh108_011"
  },
  {
   "file": "108・芳乃－解呪ver1.01",
   "text": "「我很悔恨自己将诅咒留给了她。而且……」",
   "voice": "akh108_012"
  },
  {
   "file": "108・芳乃－解呪ver1.01",
   "text": "「我也很悔恨我竟然会让孩子面对危险的祟神，自己却先死掉」",
   "voice": "akh108_013"
  },
  {
   "file": "108・芳乃－解呪ver1.01",
   "text": "「最重要的是，我没能成为一个好母亲……」",
   "voice": "akh108_014"
  },
  {
   "file": "108・芳乃－解呪ver1.01",
   "text": "「不，我不行的。因为……我没能相信那孩子」",
   "voice": "akh108_015"
  },
  {
   "file": "108・芳乃－解呪ver1.01",
   "text": "「我一直很害怕……怕她问我为什么把她生下来」",
   "voice": "akh108_016"
  },
  {
   "file": "108・芳乃－解呪ver1.01",
   "text": "「怕她说自己不愿意生在一个被诅咒的家里」",
   "voice": "akh108_017"
  },
  {
   "file": "108・芳乃－解呪ver1.01",
   "text": "「可是……芳乃并没有说那样的话」",
   "voice": "akh108_018"
  },
  {
   "file": "108・芳乃－解呪ver1.01",
   "text": "「她总是用开朗的笑容看着我。看着那样的她，我也很开心……一不小心就会流出泪来……」",
   "voice": "akh108_019"
  },
  {
   "file": "108・芳乃－解呪ver1.01",
   "text": "「还害她担心我，我真是个没用的母亲」",
   "voice": "akh108_020"
  },
  {
   "file": "108・芳乃－解呪ver1.01",
   "text": "「我知道，我很清楚她对我的感情，我也很爱她」",
   "voice": "akh108_021"
  },
  {
   "file": "108・芳乃－解呪ver1.01",
   "text": "「她的笑容很耀眼，我怨的就是无法守护她笑容的自己……」",
   "voice": "akh108_022"
  },
  {
   "file": "108・芳乃－解呪ver1.01",
   "text": "「所以我希望你能替我跟她转达一句话」",
   "voice": "akh108_023"
  },
  {
   "file": "108・芳乃－解呪ver1.01",
   "text": "「不行，我软弱得让自己都讨厌。要是我去说的话肯定又会哭出来的」",
   "voice": "akh108_024"
  },
  {
   "file": "108・芳乃－解呪ver1.01",
   "text": "「那样她根本就不会理解我的话，会觉得我是在给自己的流泪找借口」",
   "voice": "akh108_025"
  },
  {
   "file": "108・芳乃－解呪ver1.01",
   "text": "「等她再长大一点之后……如果她有了喜欢的人，如果她在因我而痛苦」",
   "voice": "akh108_026"
  },
  {
   "file": "108・芳乃－解呪ver1.01",
   "text": "「请告诉她不必害怕」",
   "voice": "akh108_027"
  },
  {
   "file": "108・芳乃－解呪ver1.01",
   "text": "「我会哭只是因为我太弱小了而已。芳乃能笑，我真的很开心，我开心得甚至掉下了眼泪」",
   "voice": "akh108_028"
  },
  {
   "file": "108・芳乃－解呪ver1.01",
   "text": "「我希望她能知道和喜欢的人在一起有多幸福。我希望她能知道那是件很棒的事情」",
   "voice": "akh108_029"
  },
  {
   "file": "108・芳乃－解呪ver1.01",
   "text": "「是你和芳乃让我知道了这件事」",
   "voice": "akh108_030"
  },
  {
   "file": "108・芳乃－解呪ver1.01",
   "text": "「告诉她，谢谢你降生于世。谢谢你告诉我什么是幸福，现在我比任何人都要幸福。」",
   "voice": "akh108_031"
  },
  {
   "file": "108・芳乃－解呪ver1.01",
   "text": "「所以这次应该让你得到幸福了。你一定要比我幸福，成为世界上最幸福的人……」",
   "voice": "akh108_032"
  },
  {
   "file": "108・芳乃－解呪ver1.01",
   "text": "「……好的，如果有一天我能真诚地接受她的笑容……那我就自己去说」",
   "voice": "akh108_033"
  },
  {
   "file": "108・芳乃－解呪ver1.01",
   "text": "「其实我本来想做个更称职的母亲」",
   "voice": "akh108_034"
  },
  {
   "file": "108・芳乃－解呪ver1.01",
   "text": "「比如跟她一起做菜，跟她聊她喜欢的男孩子，看看外孙外孙女的长相」",
   "voice": "akh108_035"
  },
  {
   "file": "108・芳乃－解呪ver1.01",
   "text": "「……是啊，抱歉，是我说了奇怪的话」",
   "voice": "akh108_036"
  },
  {
   "file": "108・芳乃－解呪ver1.01",
   "text": "「诅咒解除后，我要做个称职的母亲，跟她一起过日子。我要笑着陪在她身边」",
   "voice": "akh108_037"
  },
  {
   "file": "108・芳乃－解呪ver1.01",
   "text": "「所以……我有件事要拜托你」",
   "voice": "akh108_038"
  },
  {
   "file": "108・芳乃－解呪ver1.01",
   "text": "「我……想给芳乃生个弟弟」",
   "voice": "akh108_039"
  },
  {
   "file": "108・芳乃－解呪ver1.01",
   "text": "「是啊，所以加油吧」",
   "voice": "akh108_040"
  },
  {
   "file": "108・芳乃－解呪ver1.01",
   "text": "「我很庆幸自己的丈夫是你，很庆幸自己生下了芳乃」",
   "voice": "akh108_041"
  },
  {
   "file": "108・芳乃－解呪ver1.01",
   "text": "「我很幸福，现在的我也真的非常幸福。我爱你」",
   "voice": "akh108_042"
  },
  {
   "file": "108・芳乃－解呪ver1.01",
   "text": "「你要幸福啊，芳乃」",
   "voice": "akh108_043"
  },
  {
   "file": "108・芳乃－解呪ver1.01",
   "text": "「你一定要过得比我更加幸福」",
   "voice": "akh108_044"
  },
  {
   "file": "108・芳乃－解呪ver1.01",
   "text": "「……」",
   "voice": "akh108_045"
  }
 ]
}