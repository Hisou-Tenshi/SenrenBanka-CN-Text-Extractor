{
 "character": "外国女性Ｂ",
 "count": 9,
 "lines": [
  {
   "file": "305・ムラサメちゃんルート０５ver1.2",
   "text": "「你是本地的学生吧？这身校服真好看啊」",
   "voice": "gjb305_001"
  },
  {
   "file": "305・ムラサメちゃんルート０５ver1.2",
   "text": "「你好。虽然我是第三次来穗织了，但这还是第一次和学生说上话呢」",
   "voice": "gjb305_002"
  },
  {
   "file": "305・ムラサメちゃんルート０５ver1.2",
   "text": "「它独特的文化非常了不起」",
   "voice": "gjb305_003"
  },
  {
   "file": "305・ムラサメちゃんルート０５ver1.2",
   "text": "「另外，巫女跳的舞也很漂亮」",
   "voice": "gjb305_004"
  },
  {
   "file": "305・ムラサメちゃんルート０５ver1.2",
   "text": "「就连我们女性都会被那种凛然之美吸引住啊」",
   "voice": "gjb305_005"
  },
  {
   "file": "305・ムラサメちゃんルート０５ver1.2",
   "text": "「你要加油做调查哦」",
   "voice": "gjb305_006"
  },
  {
   "file": "315・ムラサメちゃんルート１５ver1.3",
   "text": "「真是太魔幻了！」",
   "voice": "gjb315_001"
  },
  {
   "file": "315・ムラサメちゃんルート１５ver1.3",
   "text": "「ＨＥＹ！请朝镜头这边看！」",
   "voice": "gjb315_002"
  },
  {
   "file": "502・サブ－アルバイトver1.00",
   "text": "「老板，在营业吗？」",
   "voice": "gjb502_001"
  }
 ]
}