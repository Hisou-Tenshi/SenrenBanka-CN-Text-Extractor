{
 "character": "老人",
 "count": 9,
 "lines": [
  {
   "file": "104・芳乃－記者会見ver1.05",
   "text": "「我还以为在我有生之年没法看到巫女大人的婚礼，所以难受死了呢……」",
   "voice": "oji104_001"
  },
  {
   "file": "104・芳乃－記者会見ver1.05",
   "text": "「没想到突然就找到了对象……值得庆贺！」",
   "voice": "oji104_002"
  },
  {
   "file": "104・芳乃－記者会見ver1.05",
   "text": "「看样子，在看到巫女大人的新娘装之前还得多活一阵子了啊」",
   "voice": "oji104_003"
  },
  {
   "file": "104・芳乃－記者会見ver1.05",
   "text": "「新郎官竟然是他呀！」",
   "voice": "oji104_004"
  },
  {
   "file": "104・芳乃－記者会見ver1.05",
   "text": "「喂，你们两个干什么呢。别愣在那，赶紧来这边坐下跟我们好好讲讲」",
   "voice": "oji104_005"
  },
  {
   "file": "104・芳乃－記者会見ver1.05",
   "text": "「关于这个，新郎官这边怎么想的？」",
   "voice": "oji104_006"
  },
  {
   "file": "106・芳乃－キスver1.01",
   "text": "「……」",
   "voice": "oji106_001"
  },
  {
   "file": "502・サブ－アルバイトver1.00",
   "text": "「嗯，谢谢你们」",
   "voice": "ruj502_001"
  },
  {
   "file": "502・サブ－アルバイトver1.00",
   "text": "「那就拜托了」",
   "voice": "ruj502_002"
  }
 ]
}