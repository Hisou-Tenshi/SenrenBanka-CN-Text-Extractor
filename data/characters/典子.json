{
 "character": "典子",
 "count": 59,
 "lines": [
  {
   "file": "007・レナ転入ver1.03",
   "text": "「啊，我叫小野典子哦」",
   "voice": "nrk007_005"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「话说回来，外国人就是不一样啊……尤其是身材方面」",
   "voice": "nrk007_006"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「是啊，毕竟都已经跟我们并排坐在一起上学了嘛」",
   "voice": "nrk007_007"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「偏偏在一些关键的词语上发音不准。怪不得会被骂」",
   "voice": "nrk007_008"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「你已经在流泪了……」",
   "voice": "nrk007_009"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「对，我就喜欢不蘸芥末的吃法」",
   "voice": "nrk007_010"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「真讨厌，鞍马同学在往这边看」",
   "voice": "nrk007_011"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「就是动不动就换女朋友，还会同时和两个女生交往的人」",
   "voice": "nrk007_012"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「鞍马同学，人家可是刚转学过来的留学生，你这样是不是不太好？」",
   "voice": "nrk007_013"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「蕾娜蕾娜，要不要一起出去玩？」",
   "voice": "nrk007_014"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「这样啊，有工作的话确实没办法」",
   "voice": "nrk007_015"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「拜拜」",
   "voice": "nrk007_016"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「明天见」",
   "voice": "nrk007_017"
  },
  {
   "file": "009・謎の欠片ver1.03",
   "text": "「那我想要用这块炸藕夹作祭品，上级召唤，芝麻凉菜」",
   "voice": "nrk009_001"
  },
  {
   "file": "009・謎の欠片ver1.03",
   "text": "「嘿嘿」",
   "voice": "nrk009_002"
  },
  {
   "file": "009・謎の欠片ver1.03",
   "text": "「真的！？谢谢你，巫女大人」",
   "voice": "nrk009_003"
  },
  {
   "file": "101・芳乃－弁当ver1.02",
   "text": "「巫女大人，您这是怎么了？」",
   "voice": "nrk101_001"
  },
  {
   "file": "104・芳乃－記者会見ver1.05",
   "text": "「也就是说，巫女大人喜欢上了有地将臣同学，这点是没错的吧」",
   "voice": "nrk104_001"
  },
  {
   "file": "104・芳乃－記者会見ver1.05",
   "text": "「好的！我是二年级的小野典子！」",
   "voice": "nrk104_002"
  },
  {
   "file": "104・芳乃－記者会見ver1.05",
   "text": "「请问两位是从什么时候开始交往的呢？」",
   "voice": "nrk104_003"
  },
  {
   "file": "104・芳乃－記者会見ver1.05",
   "text": "「噢！新婚伊始～！」",
   "voice": "nrk104_004"
  },
  {
   "file": "104・芳乃－記者会見ver1.05",
   "text": "「既然都交往了，那肯定已经接过吻了对吧，呀～～♪」",
   "voice": "nrk104_005"
  },
  {
   "file": "104・芳乃－記者会見ver1.05",
   "text": "「真意外。有地同学是从城里来的，我还以为早就下手了呢」",
   "voice": "nrk104_007"
  },
  {
   "file": "107・芳乃－獣耳ver1.02",
   "text": "「嗯？怎么了怎么了，发生什么事了？」",
   "voice": "nrk107_001"
  },
  {
   "file": "107・芳乃－獣耳ver1.02",
   "text": "「啊？你们两个等等，这是怎么了？」",
   "voice": "nrk107_002"
  },
  {
   "file": "107・芳乃－獣耳ver1.02",
   "text": "「发生了什么事呢？」",
   "voice": "nrk107_003"
  },
  {
   "file": "107・芳乃－獣耳ver1.02",
   "text": "「啊，回来了」",
   "voice": "nrk107_004"
  },
  {
   "file": "107・芳乃－獣耳ver1.02",
   "text": "「有地同学，如果你敢欺负巫女大人，我不会放过你的」",
   "voice": "nrk107_005"
  },
  {
   "file": "107・芳乃－獣耳ver1.02",
   "text": "「我们会一起围攻有地同学的」",
   "voice": "nrk107_006"
  },
  {
   "file": "107・芳乃－獣耳ver1.02",
   "text": "「如果有别的困难的话，随时跟我们说！」",
   "voice": "nrk107_007"
  },
  {
   "file": "107・芳乃－獣耳ver1.02",
   "text": "「虽然我们可能帮不上什么忙……但是，但是……呃……啊，对了！」",
   "voice": "nrk107_008"
  },
  {
   "file": "107・芳乃－獣耳ver1.02",
   "text": "「至少我们可以陪你去玩，帮你转换一下心情！」",
   "voice": "nrk107_009"
  },
  {
   "file": "107・芳乃－獣耳ver1.02",
   "text": "「哎～别说这么冷淡的话嘛。而且实际上我们确实帮不上别的忙啊」",
   "voice": "nrk107_010"
  },
  {
   "file": "107・芳乃－獣耳ver1.02",
   "text": "「我们又没有男朋友，也不可能商量恋爱的烦恼吧？学习也不是巫女大人的对手」",
   "voice": "nrk107_011"
  },
  {
   "file": "107・芳乃－獣耳ver1.02",
   "text": "「是吧？」",
   "voice": "nrk107_012"
  },
  {
   "file": "107・芳乃－獣耳ver1.02",
   "text": "「嘿嘿……感觉好开心呀」",
   "voice": "nrk107_013"
  },
  {
   "file": "107・芳乃－獣耳ver1.02",
   "text": "「我也是」",
   "voice": "nrk107_014"
  },
  {
   "file": "107・芳乃－獣耳ver1.02",
   "text": "「啊，对了！那下次，我们女生一起去玩吧！」",
   "voice": "nrk107_015"
  },
  {
   "file": "107・芳乃－獣耳ver1.02",
   "text": "「啊……还是不太情愿吗？」",
   "voice": "nrk107_016"
  },
  {
   "file": "107・芳乃－獣耳ver1.02",
   "text": "「既然都是聊天发牢骚，叫女子会也是可以的吧？」",
   "voice": "nrk107_017"
  },
  {
   "file": "110・芳乃－初体験ver1.01",
   "text": "「强迫巫女大人做了这样那样的事……！？」",
   "voice": "nrk110_001"
  },
  {
   "file": "110・芳乃－初体験ver1.01",
   "text": "「是吗？」",
   "voice": "nrk110_002"
  },
  {
   "file": "110・芳乃－初体験ver1.01",
   "text": "「榻榻米神是什么？」",
   "voice": "nrk110_003"
  },
  {
   "file": "110・芳乃－初体験ver1.01",
   "text": "「啊，我也是」",
   "voice": "nrk110_004"
  },
  {
   "file": "202・茉子－実家ver1.01",
   "text": "「对啊！蕾娜说得对！」",
   "voice": "nrk202_001"
  },
  {
   "file": "204・茉子－気持ちver1.00",
   "text": "「毕竟是巫女大人的婚姻大事，父母常常会提起嘛」",
   "voice": "nrk204_001"
  },
  {
   "file": "204・茉子－気持ちver1.00",
   "text": "「还是说——只是没有看得上的对象？」",
   "voice": "nrk204_002"
  },
  {
   "file": "204・茉子－気持ちver1.00",
   "text": "「但如果是我的话，至少会先见个面吧……接下来会怎么样就看对方的条件如何了」",
   "voice": "nrk204_003"
  },
  {
   "file": "204・茉子－気持ちver1.00",
   "text": "「……感觉我都被说成坏女人了」",
   "voice": "nrk204_004"
  },
  {
   "file": "204・茉子－気持ちver1.00",
   "text": "「啊——你别爆我的料啊！这样岂不显得我的女子力很低！」",
   "voice": "nrk204_005"
  },
  {
   "file": "204・茉子－気持ちver1.00",
   "text": "「不过嘛，在这个小镇生活的话，谁能跟得上都市的潮流啊」",
   "voice": "nrk204_006"
  },
  {
   "file": "204・茉子－気持ちver1.00",
   "text": "「为什么是你在抬头挺胸得意洋洋啊……」",
   "voice": "nrk204_007"
  },
  {
   "file": "204・茉子－気持ちver1.00",
   "text": "「好棒啊好棒啊～蕾娜喜欢狗还喜欢猫？我喜欢狗狗！」",
   "voice": "nrk204_008"
  },
  {
   "file": "204・茉子－気持ちver1.00",
   "text": "「咦？可是刚才还在的吧？」",
   "voice": "nrk204_009"
  },
  {
   "file": "204・茉子－気持ちver1.00",
   "text": "「啊哈哈——巫女大人也会开玩笑啊。感觉有点意外，好有趣啊——」",
   "voice": "nrk204_011"
  },
  {
   "file": "204・茉子－気持ちver1.00",
   "text": "「难不成是肚子饿了吗？」",
   "voice": "nrk204_012"
  },
  {
   "file": "204・茉子－気持ちver1.00",
   "text": "「狗也会过敏吗？」",
   "voice": "nrk204_013"
  },
  {
   "file": "204・茉子－気持ちver1.00",
   "text": "「话说回来，还是没看到常陆同学啊」",
   "voice": "nrk204_014"
  },
  {
   "file": "301・ムラサメちゃんルート０１ver1.3",
   "text": "「我说，今天我们到外面去吃吧？」",
   "voice": "nrk301_001"
  }
 ]
}