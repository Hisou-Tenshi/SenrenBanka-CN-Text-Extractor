{
 "character": "千代",
 "count": 20,
 "lines": [
  {
   "file": "502・サブ－アルバイトver1.00",
   "text": "「怎么？小春和有地认识吗？」",
   "voice": "chi502_004"
  },
  {
   "file": "502・サブ－アルバイトver1.00",
   "text": "「这样啊……」",
   "voice": "chi502_005"
  },
  {
   "file": "502・サブ－アルバイトver1.00",
   "text": "「这边也要一份布丁，拜托了」",
   "voice": "chi502_006"
  },
  {
   "file": "502・サブ－アルバイトver1.00",
   "text": "「社长也辛苦了」",
   "voice": "chi502_007"
  },
  {
   "file": "502・サブ－アルバイトver1.00",
   "text": "「好的，我先去休息了」",
   "voice": "chi502_008"
  },
  {
   "file": "502・サブ－アルバイトver1.00",
   "text": "「小春，你现在有空吗？」",
   "voice": "chi502_009"
  },
  {
   "file": "502・サブ－アルバイトver1.00",
   "text": "「那么，我就先告辞了」",
   "voice": "chi502_010"
  },
  {
   "file": "502・サブ－アルバイトver1.00",
   "text": "「哎？啊，我并没有觉得有多麻烦啦」",
   "voice": "chi502_011"
  },
  {
   "file": "502・サブ－アルバイトver1.00",
   "text": "「但是，该学的东西要赶快学会哦」",
   "voice": "chi502_012"
  },
  {
   "file": "502・サブ－アルバイトver1.00",
   "text": "「那么，辛苦了」",
   "voice": "chi502_013"
  },
  {
   "file": "504・サブ－芦花の目覚めver1.00",
   "text": "「早上好」",
   "voice": "chi504_001"
  },
  {
   "file": "504・サブ－芦花の目覚めver1.00",
   "text": "「好，好的……我会努力的」",
   "voice": "chi504_002"
  },
  {
   "file": "504・サブ－芦花の目覚めver1.00",
   "text": "「早上好，有地」",
   "voice": "chi504_003"
  },
  {
   "file": "504・サブ－芦花の目覚めver1.00",
   "text": "「小春，你等我一下」",
   "voice": "chi504_004"
  },
  {
   "file": "504・サブ－芦花の目覚めver1.00",
   "text": "「啊，有地，能麻烦你把门口打扫一下吗？」",
   "voice": "chi504_005"
  },
  {
   "file": "504・サブ－芦花の目覚めver1.00",
   "text": "「辛苦了，有地」",
   "voice": "chi504_006"
  },
  {
   "file": "504・サブ－芦花の目覚めver1.00",
   "text": "「谢谢你。那你就趁现在去休息一下吧」",
   "voice": "chi504_007"
  },
  {
   "file": "504・サブ－芦花の目覚めver1.00",
   "text": "「只要能在规定时间内回来就没问题」",
   "voice": "chi504_008"
  },
  {
   "file": "504・サブ－芦花の目覚めver1.00",
   "text": "「辛苦了。那我先走一步了」",
   "voice": "chi504_009"
  },
  {
   "file": "522・サブ－芦花（その後）ver1.00",
   "text": "「喂喂，你们俩个给我好好工作啊」",
   "voice": "chi522_001"
  }
 ]
}