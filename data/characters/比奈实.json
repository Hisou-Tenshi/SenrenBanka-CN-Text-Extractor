{
 "character": "比奈实",
 "count": 58,
 "lines": [
  {
   "file": "004・学院初日ver1.04",
   "text": "「你好，我是你的班主任中条比奈实」",
   "voice": "hin004_003"
  },
  {
   "file": "004・学院初日ver1.04",
   "text": "「嗯，请多多指教」",
   "voice": "hin004_004"
  },
  {
   "file": "004・学院初日ver1.04",
   "text": "「没关系的。我差点还以为你迷路了或者出什么事了呢，现在总算放心了」",
   "voice": "hin004_005"
  },
  {
   "file": "004・学院初日ver1.04",
   "text": "「我们还要办一些简单的手续和确认工作，现在就和我一起来办公室吧」",
   "voice": "hin004_006"
  },
  {
   "file": "004・学院初日ver1.04",
   "text": "「谢谢你。那你就坐最后那一排吧，就在鞍马同学后面」",
   "voice": "hin004_007"
  },
  {
   "file": "004・学院初日ver1.04",
   "text": "「如果他遇到了什么难事就请你帮他一把，鞍马同学」",
   "voice": "hin004_008"
  },
  {
   "file": "004・学院初日ver1.04",
   "text": "「好了。那我们去参加开学典礼吧。大家跟我来」",
   "voice": "hin004_009"
  },
  {
   "file": "004・学院初日ver1.04",
   "text": "「啊，对了，有地同学」",
   "voice": "hin004_010"
  },
  {
   "file": "004・学院初日ver1.04",
   "text": "「我有点事要跟你说，放学回家前你能稍微在学校留一会儿吗？应该不会要太久的」",
   "voice": "hin004_011"
  },
  {
   "file": "004・学院初日ver1.04",
   "text": "「不好意思我来晚了」",
   "voice": "hin004_012"
  },
  {
   "file": "004・学院初日ver1.04",
   "text": "「驹川大夫也是我们学校的代理医师」",
   "voice": "hin004_013"
  },
  {
   "file": "004・学院初日ver1.04",
   "text": "「有地同学之前让驹川大夫治过伤吗？是怎么搞的？」",
   "voice": "hin004_014"
  },
  {
   "file": "004・学院初日ver1.04",
   "text": "「是吗。那就好」",
   "voice": "hin004_015"
  },
  {
   "file": "004・学院初日ver1.04",
   "text": "「不客气。那我就先告辞了」",
   "voice": "hin004_016"
  },
  {
   "file": "005・鍛錬ver1.04",
   "text": "「啊，已经响铃了」",
   "voice": "hin005_001"
  },
  {
   "file": "005・鍛錬ver1.04",
   "text": "「那么今天的课先上到这里」",
   "voice": "hin005_002"
  },
  {
   "file": "005・鍛錬ver1.04",
   "text": "「那么，大家明天见。一定要注意安全，不要发生意外」",
   "voice": "hin005_003"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「听说列支敦瑙尔同学一边在旅馆工作一边留学」",
   "voice": "hin007_001"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「如果她有什么困难的话，大家要尽力帮帮她哦」",
   "voice": "hin007_002"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「那么，提问就到此为止」",
   "voice": "hin007_003"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「如果还有什么想问的，请在下课时间问吧」",
   "voice": "hin007_004"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「好了各位，请坐到座位上，要开始上课啦」",
   "voice": "hin007_005"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「然后从平安时代末期开始到镰仓时代，佛教开始产生变革」",
   "voice": "hin007_006"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「净土宗，净土真宗，时宗，法华宗，临济宗，曹洞宗」",
   "voice": "hin007_007"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「这六个宗派被称为镰仓新佛教……」",
   "voice": "hin007_008"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「但这是稍微靠后的时代的事了，以后再找时间讲解吧」",
   "voice": "hin007_009"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「有地同学」",
   "voice": "hin007_010"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「有地将臣同学？」",
   "voice": "hin007_011"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「身体不舒服吗？」",
   "voice": "hin007_012"
  },
  {
   "file": "007・レナ転入ver1.03",
   "text": "「那么在上课的时候请集中精神」",
   "voice": "hin007_013"
  },
  {
   "file": "009・謎の欠片ver1.03",
   "text": "「今天的课就到这里。各位同学，回家的路上请多加小心」",
   "voice": "hin009_001"
  },
  {
   "file": "101・芳乃－弁当ver1.02",
   "text": "「就此，新设立了守卫院御所的西面武士组织」",
   "voice": "hin101_001"
  },
  {
   "file": "101・芳乃－弁当ver1.02",
   "text": "「北面武士是白河上皇时期为了对抗寺社势力所设立的组织」",
   "voice": "hin101_002"
  },
  {
   "file": "101・芳乃－弁当ver1.02",
   "text": "「而西面武士则是后鸟羽上皇时期为倒幕所设」",
   "voice": "hin101_003"
  },
  {
   "file": "101・芳乃－弁当ver1.02",
   "text": "「请大家记住，这两者都是朝廷的护卫，但是诞生的原因并不相同」",
   "voice": "hin101_004"
  },
  {
   "file": "101・芳乃－弁当ver1.02",
   "text": "「就到这里，今天的课就到此结束，大家辛苦了」",
   "voice": "hin101_005"
  },
  {
   "file": "102・芳乃－告白ver1.03",
   "text": "「那么，各位回家路上要多加小心」",
   "voice": "hin102_001"
  },
  {
   "file": "104・芳乃－記者会見ver1.05",
   "text": "「各位在干什么呢？已经到上课时间了」",
   "voice": "hin104_001"
  },
  {
   "file": "104・芳乃－記者会見ver1.05",
   "text": "「说完了就赶快解散。请大家回到自己的座位上」",
   "voice": "hin104_002"
  },
  {
   "file": "104・芳乃－記者会見ver1.05",
   "text": "「鞍马同学是别的年级的吧。请你赶紧回自己的教室」",
   "voice": "hin104_003"
  },
  {
   "file": "104・芳乃－記者会見ver1.05",
   "text": "「还有那边的――为什么连老师们都在旁边看戏啊！」",
   "voice": "hin104_004"
  },
  {
   "file": "104・芳乃－記者会見ver1.05",
   "text": "「现在要上课了，请你们出去」",
   "voice": "hin104_005"
  },
  {
   "file": "107・芳乃－獣耳ver1.02",
   "text": "「由此，镰仓幕府开始了统治」",
   "voice": "hin107_001"
  },
  {
   "file": "107・芳乃－獣耳ver1.02",
   "text": "「有地同学，你怎么了？有什么不明白的地方吗？」",
   "voice": "hin107_002"
  },
  {
   "file": "107・芳乃－獣耳ver1.02",
   "text": "「……我知道了。但是，请你认真听课」",
   "voice": "hin107_003"
  },
  {
   "file": "107・芳乃－獣耳ver1.02",
   "text": "「那，现在继续上课」",
   "voice": "hin107_004"
  },
  {
   "file": "201・茉子－婚約解消ver1.01",
   "text": "「于是想利用文保的和谈来解决朝廷的两统迭立，然而协商陷入了僵局」",
   "voice": "hin201_001"
  },
  {
   "file": "201・茉子－婚約解消ver1.01",
   "text": "「最后并没有划定皇位继承的明确条款，对立持续了下去」",
   "voice": "hin201_002"
  },
  {
   "file": "201・茉子－婚約解消ver1.01",
   "text": "「下一年，接受花园天皇的让位并荣登大宝的便是大觉寺统的后醍醐天皇——」",
   "voice": "hin201_003"
  },
  {
   "file": "201・茉子－婚約解消ver1.01",
   "text": "「接下来的内容我们下次再讲，今天就讲到这里吧」",
   "voice": "hin201_004"
  },
  {
   "file": "208・茉子－いちゃラヴver1.00",
   "text": "「你们两个，有什么好笑的啊」",
   "voice": "hin208_001"
  },
  {
   "file": "208・茉子－いちゃラヴver1.00",
   "text": "「老师我现在很生气！你们在听我讲话吗！？」",
   "voice": "hin208_002"
  },
  {
   "file": "208・茉子－いちゃラヴver1.00",
   "text": "「别再笑了行吗，给我好好反省！」",
   "voice": "hin208_003"
  },
  {
   "file": "305・ムラサメちゃんルート０５ver1.2",
   "text": "「好了，今天的课程就到这」",
   "voice": "hin305_001"
  },
  {
   "file": "305・ムラサメちゃんルート０５ver1.2",
   "text": "「不是值日生的同学就回家吧，注意安全」",
   "voice": "hin305_002"
  },
  {
   "file": "308・ムラサメちゃんルート０８ver1.2",
   "text": "「那么今天的课到此为止」",
   "voice": "hin308_001"
  },
  {
   "file": "308・ムラサメちゃんルート０８ver1.2",
   "text": "「值日生别忘了打扫」",
   "voice": "hin308_002"
  },
  {
   "file": "505・サブ－ピンとくる２人ver1.00",
   "text": "「今天也辛苦大家了」",
   "voice": "hin505_001"
  }
 ]
}