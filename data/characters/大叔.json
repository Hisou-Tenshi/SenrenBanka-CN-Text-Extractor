{
 "character": "大叔",
 "count": 11,
 "lines": [
  {
   "file": "104・芳乃－記者会見ver1.05",
   "text": "「没错没错！你这人可是想杀都杀不死啊」",
   "voice": "occ104_001"
  },
  {
   "file": "104・芳乃－記者会見ver1.05",
   "text": "「甭说这个了，痛快喝吧！哇哈哈哈！」",
   "voice": "occ104_002"
  },
  {
   "file": "104・芳乃－記者会見ver1.05",
   "text": "「比想象中还普通啊。还以为是个更俊俏点的小伙子呢，简直就是一副路人脸啊」",
   "voice": "occ104_003"
  },
  {
   "file": "104・芳乃－記者会見ver1.05",
   "text": "「放什么屁，你能当候补，那我就更不用说了！哇哈哈哈！」",
   "voice": "occ104_004"
  },
  {
   "file": "104・芳乃－記者会見ver1.05",
   "text": "「不不不，最重要的不是小孩吗！什么时候要小孩！？」",
   "voice": "occ104_005"
  },
  {
   "file": "104・芳乃－記者会見ver1.05",
   "text": "「甭说废话！这可是大事！」",
   "voice": "occ104_006"
  },
  {
   "file": "104・芳乃－記者会見ver1.05",
   "text": "「真不干脆。你这样也算是带种的大老爷们吗！？」",
   "voice": "occ104_007"
  },
  {
   "file": "104・芳乃－記者会見ver1.05",
   "text": "「噢！豪迈豪迈！酒量不错嘛！」",
   "voice": "occ104_008"
  },
  {
   "file": "104・芳乃－記者会見ver1.05",
   "text": "「哦哦！新郎官好样的！继续喝继续喝！大麦果汁这里也有」",
   "voice": "occ104_009"
  },
  {
   "file": "106・芳乃－キスver1.01",
   "text": "「好般配哦好般配哦」",
   "voice": "occ106_001"
  },
  {
   "file": "106・芳乃－キスver1.01",
   "text": "「哈哈哈，与其把闲心用在吐槽上，不如带着巫女大人好好约会」",
   "voice": "occ106_002"
  }
 ]
}