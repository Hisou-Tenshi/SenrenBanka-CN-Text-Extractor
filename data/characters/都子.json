{
 "character": "都子",
 "count": 7,
 "lines": [
  {
   "file": "114・芳乃－ＥＰver1.01",
   "text": "「没想到我家未来的媳妇是这么可爱的小姑娘！」",
   "voice": "myk114_001"
  },
  {
   "file": "114・芳乃－ＥＰver1.01",
   "text": "「其实，我一直都想要一个女儿，而不是这一点都不可爱的儿子！」",
   "voice": "myk114_002"
  },
  {
   "file": "316・ムラサメちゃんルート１６ver1.2",
   "text": "「我是她的妈妈，有地都子。我家儿子一直受你照顾了」",
   "voice": "myk316_001"
  },
  {
   "file": "316・ムラサメちゃんルート１６ver1.2",
   "text": "「不过还真是个可爱的小姑娘呀」",
   "voice": "myk316_002"
  },
  {
   "file": "316・ムラサメちゃんルート１６ver1.2",
   "text": "「简直就像是日本人偶一样」",
   "voice": "myk316_003"
  },
  {
   "file": "316・ムラサメちゃんルート１６ver1.2",
   "text": "「真是的，他还没跟人家女孩子说清楚吗？」",
   "voice": "myk316_004"
  },
  {
   "file": "316・ムラサメちゃんルート１６ver1.2",
   "text": "「小雨，你就叫我妈吗吧」",
   "voice": "myk316_005"
  }
 ]
}