{
 "character": "爸爸",
 "count": 11,
 "lines": [
  {
   "file": "414レナ・イザナウ",
   "text": "「可不止爷爷哦，蕾娜」",
   "voice": "pap414_001"
  },
  {
   "file": "414レナ・イザナウ",
   "text": "「哈哈哈，你忘记了吗，蕾娜」",
   "voice": "pap414_002"
  },
  {
   "file": "414レナ・イザナウ",
   "text": "「快吃吧，一会儿菜就凉了」",
   "voice": "pap414_003"
  },
  {
   "file": "414レナ・イザナウ",
   "text": "「当然记得啦，蕾娜」",
   "voice": "pap414_004"
  },
  {
   "file": "414レナ・イザナウ",
   "text": "「我爱你，蕾娜」",
   "voice": "pap414_005"
  },
  {
   "file": "414レナ・イザナウ",
   "text": "「真的是这样吗？」",
   "voice": "pap414_006"
  },
  {
   "file": "414レナ・イザナウ",
   "text": "「家庭本来就应该是一个整体才对」",
   "voice": "pap414_007"
  },
  {
   "file": "414レナ・イザナウ",
   "text": "「来，蕾娜也快吃吧」",
   "voice": "pap414_009"
  },
  {
   "file": "414レナ・イザナウ",
   "text": "「你要是不吃的话，爸爸就要全部吃光了哦」",
   "voice": "pap414_010"
  },
  {
   "file": "414レナ・イザナウ",
   "text": "「那就对自己诚实一点嘛」",
   "voice": "pap414_011"
  },
  {
   "file": "414レナ・イザナウ",
   "text": "「你闹够了没有，蕾娜！」",
   "voice": "pap414_012"
  }
 ]
}