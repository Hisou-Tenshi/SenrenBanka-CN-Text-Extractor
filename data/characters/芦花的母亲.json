{
 "character": "芦花的母亲",
 "count": 69,
 "lines": [
  {
   "file": "502・サブ－アルバイトver1.00",
   "text": "「怎么了？喊这么大声」",
   "voice": "rkh502_001"
  },
  {
   "file": "502・サブ－アルバイトver1.00",
   "text": "「有地将臣……你是都子的儿子？」",
   "voice": "rkh502_002"
  },
  {
   "file": "502・サブ－アルバイトver1.00",
   "text": "「哇……好久没见了，都长这么大了。以前你还经常和芦花一起玩呢」",
   "voice": "rkh502_003"
  },
  {
   "file": "502・サブ－アルバイトver1.00",
   "text": "「是嘛，那以后就麻烦你了」",
   "voice": "rkh502_004"
  },
  {
   "file": "502・サブ－アルバイトver1.00",
   "text": "「哎呀，这孩子真稳重」",
   "voice": "rkh502_005"
  },
  {
   "file": "502・サブ－アルバイトver1.00",
   "text": "「好的」",
   "voice": "rkh502_006"
  },
  {
   "file": "502・サブ－アルバイトver1.00",
   "text": "「谢谢。然后是，抹茶抹茶～」",
   "voice": "rkh502_007"
  },
  {
   "file": "502・サブ－アルバイトver1.00",
   "text": "「好的。哎呀，白玉团子用完了」",
   "voice": "rkh502_008"
  },
  {
   "file": "502・サブ－アルバイトver1.00",
   "text": "「好嘞好嘞」",
   "voice": "rkh502_009"
  },
  {
   "file": "502・サブ－アルバイトver1.00",
   "text": "「顺便学一下怎么做芭菲吧」",
   "voice": "rkh502_010"
  },
  {
   "file": "502・サブ－アルバイトver1.00",
   "text": "「怎么了？」",
   "voice": "rkh502_011"
  },
  {
   "file": "502・サブ－アルバイトver1.00",
   "text": "「啊，这样啊。嗯，那这个就交给我来做吧」",
   "voice": "rkh502_012"
  },
  {
   "file": "502・サブ－アルバイトver1.00",
   "text": "「这种事情？」",
   "voice": "rkh502_013"
  },
  {
   "file": "502・サブ－アルバイトver1.00",
   "text": "「是啊。这类事情我们经常做。最开始是芦花提起的，她说咱们家店小，不学会随机应变的话生意就好不起来」",
   "voice": "rkh502_014"
  },
  {
   "file": "502・サブ－アルバイトver1.00",
   "text": "「然后不知不觉，咱们店的客人就变得越来越多了……这都是多亏了芦花」",
   "voice": "rkh502_015"
  },
  {
   "file": "502・サブ－アルバイトver1.00",
   "text": "「不过我们也相应地忙起来了，并不都是好事。哈哈」",
   "voice": "rkh502_016"
  },
  {
   "file": "502・サブ－アルバイトver1.00",
   "text": "「学校刚毕业就开始了」",
   "voice": "rkh502_017"
  },
  {
   "file": "502・サブ－アルバイトver1.00",
   "text": "「当时她跟我们商量毕业后的打算，结果跟她爸吵了一架」",
   "voice": "rkh502_018"
  },
  {
   "file": "502・サブ－アルバイトver1.00",
   "text": "「她爸问她毕业之后准备干什么，她随口说了句要在家里干活」",
   "voice": "rkh502_019"
  },
  {
   "file": "502・サブ－アルバイトver1.00",
   "text": "「然后她爸就生气了。“你能做好才怪了”“我就能做好”“那你就做给我看！”两人就这样吵了起来」",
   "voice": "rkh502_020"
  },
  {
   "file": "502・サブ－アルバイトver1.00",
   "text": "「我一开始以为他们只是斗斗嘴，没想到两人都赌气起来」",
   "voice": "rkh502_021"
  },
  {
   "file": "502・サブ－アルバイトver1.00",
   "text": "「经营可不是什么轻松的活」",
   "voice": "rkh502_022"
  },
  {
   "file": "502・サブ－アルバイトver1.00",
   "text": "「我当时觉得，要是她真的想干的话，让她实际体验一下是最好的」",
   "voice": "rkh502_023"
  },
  {
   "file": "502・サブ－アルバイトver1.00",
   "text": "「多亏了那孩子，现在顾客也多起来了……别看她爸那样，其实心里可不甘心了」",
   "voice": "rkh502_024"
  },
  {
   "file": "502・サブ－アルバイトver1.00",
   "text": "「他当然高兴，因为女儿很重视这家店，但同时又觉得不甘心，因为赌气让女儿试了一试她就做得这么好」",
   "voice": "rkh502_025"
  },
  {
   "file": "502・サブ－アルバイトver1.00",
   "text": "「啊，我不是说现在他们还在吵架。只是她爸自己觉得不甘心而已。你不要放在心上啦」",
   "voice": "rkh502_026"
  },
  {
   "file": "502・サブ－アルバイトver1.00",
   "text": "「而且啊，比起经营，她爸的性格还是更适合做个点心师傅」",
   "voice": "rkh502_027"
  },
  {
   "file": "502・サブ－アルバイトver1.00",
   "text": "「现在的工作方式，才更适合他的性格」",
   "voice": "rkh502_028"
  },
  {
   "file": "502・サブ－アルバイトver1.00",
   "text": "「好的。这个就麻烦你给芦花拿过去吧」",
   "voice": "rkh502_029"
  },
  {
   "file": "504・サブ－芦花の目覚めver1.00",
   "text": "「我不太喜欢咖啡。而且我还要研究抹茶苏打，你们就不要问我啦」",
   "voice": "rkh504_001"
  },
  {
   "file": "504・サブ－芦花の目覚めver1.00",
   "text": "「你看他们聊得多起劲」",
   "voice": "rkh504_002"
  },
  {
   "file": "504・サブ－芦花の目覚めver1.00",
   "text": "「这都是多亏了你啊」",
   "voice": "rkh504_003"
  },
  {
   "file": "504・サブ－芦花の目覚めver1.00",
   "text": "「但是咖啡和抹茶苏打，都是你想出来的主意吧？」",
   "voice": "rkh504_004"
  },
  {
   "file": "505・サブ－ピンとくる２人ver1.00",
   "text": "「啊，小春」",
   "voice": "rkh505_001"
  },
  {
   "file": "505・サブ－ピンとくる２人ver1.00",
   "text": "「你也辛苦了……哎，今天是轮到小春上班吗？」",
   "voice": "rkh505_002"
  },
  {
   "file": "505・サブ－ピンとくる２人ver1.00",
   "text": "「那个啊。我不喝咖啡所以不太清楚，不过喜欢咖啡的人的评价都不错」",
   "voice": "rkh505_003"
  },
  {
   "file": "505・サブ－ピンとくる２人ver1.00",
   "text": "「那孩子看上去是真的很开心。所以我家那口子就有点不甘心的样子」",
   "voice": "rkh505_004"
  },
  {
   "file": "505・サブ－ピンとくる２人ver1.00",
   "text": "「你别在意啦。他反而鼓足了干劲，还说些什么“才不会输给你的！”」",
   "voice": "rkh505_005"
  },
  {
   "file": "505・サブ－ピンとくる２人ver1.00",
   "text": "「没事没事。他就是一个喜欢工作的人。要是不让他工作他马上就变成老糊涂了」",
   "voice": "rkh505_006"
  },
  {
   "file": "505・サブ－ピンとくる２人ver1.00",
   "text": "「不管怎么说，能让店里活跃一点总归是好事」",
   "voice": "rkh505_007"
  },
  {
   "file": "505・サブ－ピンとくる２人ver1.00",
   "text": "「接下来就看她自己了……努力工作是好事，但我更希望她能赶快找到个好人家」",
   "voice": "rkh505_008"
  },
  {
   "file": "505・サブ－ピンとくる２人ver1.00",
   "text": "「啊，那个啊，是男人没错，不过那是将臣送给她的礼物」",
   "voice": "rkh505_009"
  },
  {
   "file": "505・サブ－ピンとくる２人ver1.00",
   "text": "「将臣还叫我帮他把花藏起来不要让芦花看见」",
   "voice": "rkh505_010"
  },
  {
   "file": "505・サブ－ピンとくる２人ver1.00",
   "text": "「他说这朵花是咖啡得到认可的纪念，在打烊之后就给芦花送去了」",
   "voice": "rkh505_011"
  },
  {
   "file": "505・サブ－ピンとくる２人ver1.00",
   "text": "「如果那真是告白的花束之类的，我可就开心了」",
   "voice": "rkh505_012"
  },
  {
   "file": "505・サブ－ピンとくる２人ver1.00",
   "text": "「啊，抱歉。我忍不住说了这么多」",
   "voice": "rkh505_013"
  },
  {
   "file": "505・サブ－ピンとくる２人ver1.00",
   "text": "「那再见了」",
   "voice": "rkh505_014"
  },
  {
   "file": "506・サブ－恋愛協定ver1.00",
   "text": "「这可不是什么新品。以前有段时间我家也卖过仙贝」",
   "voice": "rkh506_001"
  },
  {
   "file": "506・サブ－恋愛協定ver1.00",
   "text": "「是很久很久之前的事了，当时还不是只卖甜品」",
   "voice": "rkh506_002"
  },
  {
   "file": "506・サブ－恋愛協定ver1.00",
   "text": "「怎么了？在那唉声叹气」",
   "voice": "rkh506_003"
  },
  {
   "file": "506・サブ－恋愛協定ver1.00",
   "text": "「怎么了？」",
   "voice": "rkh506_004"
  },
  {
   "file": "506・サブ－恋愛協定ver1.00",
   "text": "「我听说有把水换成糖水，或是在水里剪断花茎之类的方法……」",
   "voice": "rkh506_005"
  },
  {
   "file": "506・サブ－恋愛協定ver1.00",
   "text": "「这花是非洲菊吧？花头很容易折弯……恐怕不好操作吧？」",
   "voice": "rkh506_006"
  },
  {
   "file": "507・サブ－選択肢ver1.00",
   "text": "「……（盯）……」",
   "voice": "rok507_064"
  },
  {
   "file": "507・サブ－選択肢ver1.00",
   "text": "「感觉你们气氛不错……本来觉得打扰你们不太好」",
   "voice": "rok507_066"
  },
  {
   "file": "521・サブ－芦花（初体験）ver1.00",
   "text": "「早上好，将臣」",
   "voice": "rkh521_001"
  },
  {
   "file": "521・サブ－芦花（初体験）ver1.00",
   "text": "「……盯……」",
   "voice": "rkh521_002"
  },
  {
   "file": "521・サブ－芦花（初体験）ver1.00",
   "text": "「什么怎么……要我叫爸爸过来吗？」",
   "voice": "rkh521_003"
  },
  {
   "file": "521・サブ－芦花（初体験）ver1.00",
   "text": "「什么，还没到那一步吗？妈妈我都想早点抱孙子了呢」",
   "voice": "rkh521_004"
  },
  {
   "file": "521・サブ－芦花（初体験）ver1.00",
   "text": "「……唉……你都多少岁了还一步一步来……将臣也真是不容易啊」",
   "voice": "rkh521_005"
  },
  {
   "file": "521・サブ－芦花（初体験）ver1.00",
   "text": "「你可是我的独生女，得好好干才行啊」",
   "voice": "rkh521_006"
  },
  {
   "file": "521・サブ－芦花（初体験）ver1.00",
   "text": "「而且……你一个处女，这么大年纪才第一次交男朋友，还有什么好要面子的……」",
   "voice": "rkh521_007"
  },
  {
   "file": "521・サブ－芦花（初体験）ver1.00",
   "text": "「将臣也是个血气方刚的男孩子，你这样吊着他可是会被嫌弃的哦？」",
   "voice": "rkh521_008"
  },
  {
   "file": "521・サブ－芦花（初体験）ver1.00",
   "text": "「你说是吧，将臣？」",
   "voice": "rkh521_009"
  },
  {
   "file": "521・サブ－芦花（初体験）ver1.00",
   "text": "「也罢，先不说这些了，你们工作要认真干啊！」",
   "voice": "rkh521_010"
  },
  {
   "file": "521・サブ－芦花（初体験）ver1.00",
   "text": "「我确实想要早点抱孙子嘛」",
   "voice": "rkh521_011"
  },
  {
   "file": "521・サブ－芦花（初体験）ver1.00",
   "text": "「将臣，你还要在店里呆一会儿吧？」",
   "voice": "rkh521_012"
  },
  {
   "file": "521・サブ－芦花（初体験）ver1.00",
   "text": "「帮我提醒她要注意关紧门窗」",
   "voice": "rkh521_013"
  },
  {
   "file": "521・サブ－芦花（初体験）ver1.00",
   "text": "「辛苦你们了」",
   "voice": "rkh521_014"
  }
 ]
}