{
 "character": "白狛",
 "count": 82,
 "lines": [
  {
   "file": "414レナ・イザナウ",
   "text": "「可是姐姐大人，您这样说我也很为难」",
   "voice": "srk414_002"
  },
  {
   "file": "414レナ・イザナウ",
   "text": "「…………」",
   "voice": "srk414_003"
  },
  {
   "file": "414レナ・イザナウ",
   "text": "「你这家伙，不是姐姐大人」",
   "voice": "srk414_004"
  },
  {
   "file": "421レナ・玉石の女神",
   "text": "「又开始说教了吗」",
   "voice": "srk421_001"
  },
  {
   "file": "421レナ・玉石の女神",
   "text": "「姐姐大人，您这样说我也很为难」",
   "voice": "srk421_002"
  },
  {
   "file": "421レナ・玉石の女神",
   "text": "「虽说我们同为山神，皆生于这穗织崇山之上，可姐姐大人生于玉石，我则是生于野兽」",
   "voice": "srk421_003"
  },
  {
   "file": "421レナ・玉石の女神",
   "text": "「那是当然」",
   "voice": "srk421_004"
  },
  {
   "file": "421レナ・玉石の女神",
   "text": "「姐姐大人，玉石供人观赏，受人喜爱，您当然会对人们更加宽容」",
   "voice": "srk421_005"
  },
  {
   "file": "421レナ・玉石の女神",
   "text": "「但是兽类，却终日遭人猎捕」",
   "voice": "srk421_006"
  },
  {
   "file": "421レナ・玉石の女神",
   "text": "「前几日，我还见有好几人给野犬架上靶子，骑马追赶并且用弓箭射它」",
   "voice": "srk421_007"
  },
  {
   "file": "421レナ・玉石の女神",
   "text": "「既然您知道，那就请您理解我的愤怒」",
   "voice": "srk421_008"
  },
  {
   "file": "421レナ・玉石の女神",
   "text": "「还有，也请您不要再用乳名叫我了」",
   "voice": "srk421_009"
  },
  {
   "file": "421レナ・玉石の女神",
   "text": "「我明白了，明白了！请您不要再说了」",
   "voice": "srk421_010"
  },
  {
   "file": "421レナ・玉石の女神",
   "text": "「难道，您神色不悦也是因为这个……」",
   "voice": "srk421_011"
  },
  {
   "file": "421レナ・玉石の女神",
   "text": "「……啊！？」",
   "voice": "srk421_012"
  },
  {
   "file": "421レナ・玉石の女神",
   "text": "「我明白了，姐姐大人……」",
   "voice": "srk421_013"
  },
  {
   "file": "421レナ・玉石の女神",
   "text": "「反正我就是说不过姐姐大人」",
   "voice": "srk421_014"
  },
  {
   "file": "423レナ・叢雲より生じたる",
   "text": "「姐姐大人，您居然做了这样的蠢事」",
   "voice": "srk423_001"
  },
  {
   "file": "423レナ・叢雲より生じたる",
   "text": "「只不过是偶然看到」",
   "voice": "srk423_002"
  },
  {
   "file": "423レナ・叢雲より生じたる",
   "text": "「但是，您身为高贵的媛神，居然把真名告诉凡人，简直难以置信」",
   "voice": "srk423_003"
  },
  {
   "file": "423レナ・叢雲より生じたる",
   "text": "「姐姐大人……那个凡人一定无法想象」",
   "voice": "srk423_004"
  },
  {
   "file": "423レナ・叢雲より生じたる",
   "text": "「凡人怎么能想象得到，那把刀居然是您削开自己的身体做出来的」",
   "voice": "srk423_005"
  },
  {
   "file": "423レナ・叢雲より生じたる",
   "text": "「那您为什么这么做？」",
   "voice": "srk423_006"
  },
  {
   "file": "423レナ・叢雲より生じたる",
   "text": "「真是的。姐姐大人，您再怎么偏袒人类，这做得也未免太过了」",
   "voice": "srk423_007"
  },
  {
   "file": "423レナ・叢雲より生じたる",
   "text": "「……」",
   "voice": "srk423_008"
  },
  {
   "file": "423レナ・叢雲より生じたる",
   "text": "「嗯，既然他带着姐姐大人的刀，那自然是回来了」",
   "voice": "srk423_009"
  },
  {
   "file": "423レナ・叢雲より生じたる",
   "text": "「听说，他漂亮地斩下了敌方大将的首级，立了大功……」",
   "voice": "srk423_010"
  },
  {
   "file": "423レナ・叢雲より生じたる",
   "text": "「……我记得并没有受伤的气味」",
   "voice": "srk423_011"
  },
  {
   "file": "423レナ・叢雲より生じたる",
   "text": "「（看来，我没猜错）」",
   "voice": "srk423_012"
  },
  {
   "file": "423レナ・叢雲より生じたる",
   "text": "「（姐姐大人……居然爱上了人类）」",
   "voice": "srk423_013"
  },
  {
   "file": "424レナ・トモダチ",
   "text": "「姐姐大人……」",
   "voice": "srk424_001"
  },
  {
   "file": "425レナ・呪いの真実",
   "text": "「您这样，未免太过无欲无求了」",
   "voice": "srk425_001"
  },
  {
   "file": "425レナ・呪いの真実",
   "text": "「是吗……」",
   "voice": "srk425_002"
  },
  {
   "file": "425レナ・呪いの真実",
   "text": "「两天都没生出来，这多半是活不成了」",
   "voice": "srk425_003"
  },
  {
   "file": "425レナ・呪いの真実",
   "text": "「她孩子的魂魄恐怕是被魑魅魍魉勾住了」",
   "voice": "srk425_004"
  },
  {
   "file": "425レナ・呪いの真実",
   "text": "「什么，姐姐大人！？您在开什么玩笑」",
   "voice": "srk425_005"
  },
  {
   "file": "425レナ・呪いの真実",
   "text": "「尚未出世的孩子，那可是黄泉之神的所有物！」",
   "voice": "srk425_006"
  },
  {
   "file": "425レナ・呪いの真実",
   "text": "「而且黄泉之神的地位比我们更高，您若是出手相救，必定会遭天罚！」",
   "voice": "srk425_007"
  },
  {
   "file": "425レナ・呪いの真実",
   "text": "「姐姐大人……万万不可！此事真的万万不可」",
   "voice": "srk425_008"
  },
  {
   "file": "425レナ・呪いの真実",
   "text": "「我等身为一方神灵，要是侵犯了诸神的天理，就再也……」",
   "voice": "srk425_009"
  },
  {
   "file": "425レナ・呪いの真実",
   "text": "「请不要这么做……区区凡人，区区凡人的命运随他去就是了！」",
   "voice": "srk425_010"
  },
  {
   "file": "425レナ・呪いの真実",
   "text": "「而且，那个男人还背叛了姐姐大人」",
   "voice": "srk425_011"
  },
  {
   "file": "425レナ・呪いの真実",
   "text": "「可姐姐大人……你却要为他做到这个地步，我……！我真的无法理解……」",
   "voice": "srk425_012"
  },
  {
   "file": "425レナ・呪いの真実",
   "text": "「我可怜的姐姐大人……」",
   "voice": "srk425_013"
  },
  {
   "file": "425レナ・呪いの真実",
   "text": "「但是，就算改变了模样，失去了力量，姐姐大人也依然是我的姐姐大人」",
   "voice": "srk425_014"
  },
  {
   "file": "425レナ・呪いの真実",
   "text": "「姐姐大人，您的未了之愿，我一定会替您完成的」",
   "voice": "srk425_015"
  },
  {
   "file": "425レナ・呪いの真実",
   "text": "「您拯救的这一族血脉，由我来守护」",
   "voice": "srk425_016"
  },
  {
   "file": "425レナ・呪いの真実",
   "text": "「只要我永远守护下去……或许有一天，这一族人中会诞生出您的转世」",
   "voice": "srk425_017"
  },
  {
   "file": "427レナ・古の祝詞",
   "text": "『住手，快住手！』",
   "voice": "srk427_002"
  },
  {
   "file": "427レナ・古の祝詞",
   "text": "「（这可不妙……既要阻止他，又不得伤他，我该如何是好？」",
   "voice": "srk427_003"
  },
  {
   "file": "427レナ・古の祝詞",
   "text": "『什么！？』",
   "voice": "srk427_004"
  },
  {
   "file": "427レナ・古の祝詞",
   "text": "『你们在干什么！住手……不要利用姐姐大人做这种事！』",
   "voice": "srk427_005"
  },
  {
   "file": "427レナ・古の祝詞",
   "text": "『你们竟敢以我为祭品，以姐姐大人为宿体，发动诅咒……啊啊啊、啊啊啊啊啊！！！』",
   "voice": "srk427_006"
  },
  {
   "file": "427レナ・古の祝詞",
   "text": "『要杀我随你……但是不要把姐姐大人……不要把姐姐大人……你这混蛋！』",
   "voice": "srk427_007"
  },
  {
   "file": "427レナ・古の祝詞",
   "text": "『姐姐大人守护你们这么多年，你们考虑过她的感受吗！我决不饶你们，决不饶你们，决不饶你们！！』",
   "voice": "srk427_008"
  },
  {
   "file": "427レナ・古の祝詞",
   "text": "『才过了区区数百年，你们就如此忘恩负义……甚至对我们做出此等不肖之事』",
   "voice": "srk427_009"
  },
  {
   "file": "427レナ・古の祝詞",
   "text": "『简直天理难容！！我发誓永远、永远都不会原谅你们！！！』",
   "voice": "srk427_010"
  },
  {
   "file": "427レナ・古の祝詞",
   "text": "「你……你难道……！」",
   "voice": "srk427_048"
  },
  {
   "file": "427レナ・古の祝詞",
   "text": "「……」",
   "voice": "srk427_049"
  },
  {
   "file": "427レナ・古の祝詞",
   "text": "「闭……闭嘴，我……我只是想把你当做姐姐的替身……」",
   "voice": "srk427_050"
  },
  {
   "file": "427レナ・古の祝詞",
   "text": "「不！即便如此，我还是……」",
   "voice": "srk427_051"
  },
  {
   "file": "427レナ・古の祝詞",
   "text": "「那又如何！我和姐姐大人不一样，我憎恶人类，憎恶人类！」",
   "voice": "srk427_052"
  },
  {
   "file": "427レナ・古の祝詞",
   "text": "「……！？」",
   "voice": "srk427_053"
  },
  {
   "file": "427レナ・古の祝詞",
   "text": "「不……不要再说了」",
   "voice": "srk427_054"
  },
  {
   "file": "427レナ・古の祝詞",
   "text": "「嘴上说得倒是好听！你也不想想，我……我诅咒了多少人，诅咒了多少年！？」",
   "voice": "srk427_055"
  },
  {
   "file": "427レナ・古の祝詞",
   "text": "「无论将多少人置于死地，我心中也不会有任何波动……」",
   "voice": "srk427_056"
  },
  {
   "file": "427レナ・古の祝詞",
   "text": "「憎恶始终留在我心里……我只是一介祟神……这世上，已经没有任何人能够阻挡我！」",
   "voice": "srk427_057"
  },
  {
   "file": "427レナ・古の祝詞",
   "text": "「就算我现在变成了这样，要杀你们几个凡人还是轻而易举的！」",
   "voice": "srk427_058"
  },
  {
   "file": "427レナ・古の祝詞",
   "text": "「嚯，你终于准备大战一场了么」",
   "voice": "srk427_059"
  },
  {
   "file": "427レナ・古の祝詞",
   "text": "「什么？你想干什么？」",
   "voice": "srk427_060"
  },
  {
   "file": "427レナ・古の祝詞",
   "text": "「什么……这，莫非是……？」",
   "voice": "srk427_061"
  },
  {
   "file": "427レナ・古の祝詞",
   "text": "「不……不要说了，不要说了不要说了！」",
   "voice": "srk427_062"
  },
  {
   "file": "427レナ・古の祝詞",
   "text": "「不要……即便如此……我还是无法原谅，不想原谅」",
   "voice": "srk427_063"
  },
  {
   "file": "427レナ・古の祝詞",
   "text": "「也不能原谅……我、我不能就这么终结这一切！」",
   "voice": "srk427_064"
  },
  {
   "file": "427レナ・古の祝詞",
   "text": "「一旦原谅了人类……他们马上就会忘记这一切！」",
   "voice": "srk427_065"
  },
  {
   "file": "427レナ・古の祝詞",
   "text": "「他们会忘了自己为何被憎恶，为何被诅咒，甚至连想都不会去想！」",
   "voice": "srk427_066"
  },
  {
   "file": "427レナ・古の祝詞",
   "text": "「姐姐大人的恩情，后世又有几个人还记得！？」",
   "voice": "srk427_067"
  },
  {
   "file": "427レナ・古の祝詞",
   "text": "「我别无选择……若不这么做，她将永远消逝……」",
   "voice": "srk427_068"
  },
  {
   "file": "427レナ・古の祝詞",
   "text": "「……春日祭，将迎来重生？」",
   "voice": "srk427_069"
  },
  {
   "file": "427レナ・古の祝詞",
   "text": "「感恩的庆典……为了姐姐大人？」",
   "voice": "srk427_070"
  },
  {
   "file": "427レナ・古の祝詞",
   "text": "「……自由？」",
   "voice": "srk427_071"
  },
  {
   "file": "427レナ・古の祝詞",
   "text": "「……」",
   "voice": "srk427_072"
  }
 ]
}